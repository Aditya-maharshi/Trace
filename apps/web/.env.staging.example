# Backend API URL (Points to staging API)
VITE_API_URL=https://staging-api.trace.example.com

# Supabase Auth & Storage (Staging project)
VITE_SUPABASE_URL=https://staging-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-staging-supabase-anon-key

# API Key for backend communication (Staging keys)
VITE_API_KEY=trace_test_sk_staging_key

# Lovable Cron Auth
LOVABLE_CRON_SECRET=your_staging_cron_secret
LOVABLE_CRON_SECRET_PREVIOUS=your_previous_staging_cron_secret

# Supabase Service Role Key (Server-side ONLY - Staging)
SUPABASE_SERVICE_ROLE_KEY=your_staging_supabase_service_role_key

# Staging Flag
DEMO_MODE=false
NODE_ENV=production
