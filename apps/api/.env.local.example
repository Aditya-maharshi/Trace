# Etherscan API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Google Gemini (for Phase 6 AI narrative)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenSanctions (for wallet sanctions screening)
OPENSANCTIONS_API_KEY=your_opensanctions_api_key_here
OPENSANCTIONS_BASE_URL=https://api.opensanctions.org

# Blockscout (fallback data provider when Etherscan rate-limits or fails)
BLOCKSCOUT_BASE_URL=https://eth.blockscout.com/api
BLOCKSCOUT_API_KEY=your_blockscout_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Enable verbose logging for graph traversal
DEBUG=false

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Comma-separated list of valid API keys; callers must send one via the x-api-key header
API_KEYS=changeme-key-1,changeme-key-2

# Max requests per rate-limit window (legacy fallback for paid keys)
RATE_LIMIT_MAX=100

# Per-tier limits (guest traffic never shares a counter with paid API keys)
RATE_LIMIT_GUEST_MAX=30
RATE_LIMIT_USER_MAX=60
RATE_LIMIT_PAID_MAX=300

# Rate-limit window duration in milliseconds (default: 60 000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Shared frontend / demo keys — treated as guest and keyed by IP, not by the key
PUBLIC_API_KEYS=changeme-key-1

# BFS wall-clock budget in ms. On Vercel this defaults to 7000 so Hobby's 10s
# hard kill cannot preempt a clean partial response.
# BFS_BUDGET_MS=7000

# Etherscan V2 (chainid=1). Leftover V1 URLs are rewritten automatically.
# ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# ETHERSCAN_CHAIN_ID=1

# Groq fallback model (must exist in Groq's catalog)
# GROQ_MODEL=qwen/qwen3.8-27b

# Upstash Redis (persistent store for rate limiting and cache across serverless/multi-instance deployments)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

BINANCE_API_KEY=your_binance_api_key_here
GROQ_API_KEY=your_groq_api_key_here
XAI_API_KEY=your_xai_api_key_here
DEMO_MODE=false

# Salt used to HMAC client IPs before writing lookups.ip_address (never store plaintext)
IP_HASH_SALT=replace-with-a-long-random-string

# Sentry error tracking (optional — logging still works without it)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# External Chatbot API Key
EXTERNAL_CHATBOT_API_KEY=your_external_chatbot_api_key_here

