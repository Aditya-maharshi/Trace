# Supabase Auth & Storage (Staging project)
SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your_staging_supabase_service_role_key

# Third-party APIs (Staging / Mock keys)
GEMINI_API_KEY=your_staging_gemini_key
GROQ_API_KEY=your_staging_groq_key
EXTERNAL_CHATBOT_API_KEY=your_staging_chatbot_key
ETHERSCAN_API_KEY=your_staging_etherscan_key
OPENSANCTIONS_API_KEY=your_staging_opensanctions_key
STRIPE_SECRET_KEY=your_staging_stripe_key

# Redis (Staging)
UPSTASH_REDIS_REST_URL=your_staging_redis_url
UPSTASH_REDIS_REST_TOKEN=your_staging_redis_token

# Sentry
SENTRY_DSN=your_staging_sentry_dsn

# MCP
MCP_M2M_SECRET=your_staging_mcp_secret
MCP_ALLOWED_HOST=staging-mcp.trace.example.com

# Staging Flags
DEMO_MODE=false
NODE_ENV=production
