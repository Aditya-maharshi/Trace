<script>
  // Mobile nav toggle
  (function(){
    var toggle = document.getElementById('navToggle');
    var links = document.getElementById('navLinks');
    toggle.addEventListener('click', function(){
      var open = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    links.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){
        links.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  })();

  // Smooth scrolling for every in-page anchor link (hero buttons, nav links,
  // logo). Works even in browsers with inconsistent CSS scroll-behavior
  // support, honours each target's scroll-margin-top (so the sticky header
  // never covers the heading it jumps to), and respects reduced-motion.
  (function(){
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var anchors = document.querySelectorAll('a[href^="#"]');
    anchors.forEach(function(a){
      var hash = a.getAttribute('href');
      if (!hash || hash.length < 2) return; // skip bare "#"
      var target;
      try { target = document.querySelector(hash); } catch (err) { return; }
      if (!target) return; // href doesn't point to an id on this page

      a.addEventListener('click', function(e){
        e.preventDefault();
        target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        // Keep the URL hash in sync, but only via pushState (never a direct
        // location.hash assignment) — some sandboxed preview contexts treat
        // that as a real navigation and prompt the user. If pushState isn't
        // available or is blocked, just skip the URL update; the scroll above
        // already happened, which is what matters.
        try {
          if (history.pushState) history.pushState(null, '', hash);
        } catch (err) { /* no-op: scroll already happened */ }
      });
    });
  })();

  // Scroll-reveal via IntersectionObserver, respecting reduced motion
  (function(){
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var items = document.querySelectorAll('.reveal');
    if (reduceMotion || !('IntersectionObserver' in window)){
      items.forEach(function(el){ el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting){
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    items.forEach(function(el){ io.observe(el); });
  })();
</script>

<script>window.TRACE_INTRO_SRC = "data:video/mp4;base64,";</script>

<script>
  // ---------- Intro controller ----------
  (function(){
    var root  = document.documentElement;
    var intro = document.getElementById('intro');
    if (!intro) return;
    window.__introInit = true;

    // Head script decided not to run the intro (e.g. already seen this session)
    if (!root.classList.contains('intro-on')) { intro.parentNode.removeChild(intro); return; }

    var video = document.getElementById('introVideo');
    var skip  = document.getElementById('introSkip');
    var finished = false, watchdog = null, holdTimer = null;

    // keep the page behind the overlay out of the tab order / screen readers until the intro is over
    var behind = [].filter.call(document.body.children, function(el){ return el !== intro && el.tagName !== 'SCRIPT'; });
    behind.forEach(function(el){ el.setAttribute('inert', ''); });

    function finish(){
      if (finished) return;
      finished = true;
      clearTimeout(watchdog); clearTimeout(holdTimer);
      try { sessionStorage.setItem('traceIntroSeen', '1'); } catch(e){}
      try { video.pause(); } catch(e){}
      behind.forEach(function(el){ el.removeAttribute('inert'); });
      intro.classList.add('leaving');           // fades the overlay out
      root.classList.remove('intro-on');        // unlocks scroll + lets the hero animate in
      setTimeout(function(){ if (intro.parentNode) intro.parentNode.removeChild(intro); }, 1400);
    }

    function onStarted(){
      clearTimeout(watchdog);
      // if 'ended' never fires (stalled decode etc.) don't trap the visitor
      watchdog = setTimeout(finish, ((video.duration && isFinite(video.duration)) ? video.duration : 3) * 1000 + 3000);
    }

    function tryPlay(){
      var p;
      try { p = video.play(); } catch(e){ finish(); return; }
      if (p && typeof p.then === 'function'){ p.then(onStarted, finish); }
      else { onStarted(); }
    }

    video.addEventListener('ended', function(){ holdTimer = setTimeout(finish, 500); });
    video.addEventListener('error', finish);
    skip.addEventListener('click', finish);
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') finish(); });
    video.muted = true; video.volume = 0;              // intro is silent
    video.src = window.TRACE_INTRO_SRC;
    tryPlay();                                          // starts right away (muted, so autoplay is always allowed)
  })();
</script>

