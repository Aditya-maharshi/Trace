<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trace — Compliance Console</title>
<meta name="description" content="Wallet screening, risk alerts, and API access for VASPs and compliance teams.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ============================================================
   Theme carried over unchanged from the Trace design system:
   #06060a base, ambient orange/blue glow, grid overlay,
   white/5 glass panels, Space Grotesk + JetBrains Mono.
   Component classes (panel, hop, tag, flag, reg, act, done, btn)
   are the same ones used in the government Investigation Console —
   only the page structure and copy are commercial-specific.
   ============================================================ */
:root{
  --bg: #06060a;
  --bg-raised: #0d0d15;
  --bg-card: #101019;
  --line: rgba(255,255,255,0.08);
  --line-soft: rgba(255,255,255,0.05);
  --btc: #f7931a;
  --eth: #8c9dfc;
  --green: #2fe3a3;
  --red: #ff5c7a;
  --amber: #f0b429;
  --text: #f2f2f7;
  --text-dim: #9a9aab;
  --text-faint: #5c5c6c;
}
*{ box-sizing: border-box; }
body{
  margin:0; min-height:100vh;
  background: var(--bg); color: var(--text);
  font-family:'Space Grotesk', sans-serif;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
a{ color: inherit; text-decoration: none; }
::selection{ background: var(--btc); color:#000; }
a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible{ outline: 2px solid var(--btc); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce){
  *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }
}
.mono{ font-family:'JetBrains Mono', monospace; }

/* ---------- ambient background ---------- */
.ambient{ position: fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
.ambient .orb-a{ position:absolute; top:-25%; left:-25%; width:70vw; height:70vw; border-radius:50%; background: rgba(247,147,26,0.10); filter: blur(160px); }
.ambient .orb-b{ position:absolute; bottom:-25%; right:-25%; width:70vw; height:70vw; border-radius:50%; background: rgba(140,157,252,0.10); filter: blur(160px); }

/* ---------- advisory ---------- */
.advisory{
  position: relative; z-index: 30;
  background: rgba(247,147,26,0.07); border-bottom: 1px solid rgba(247,147,26,0.22);
  font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#e8ba7d;
  padding: 7px 24px; text-align:center;
}
.advisory b{ color: var(--btc); font-weight:500; }

/* ---------- topbar ---------- */
.topbar{
  position: relative; z-index: 20;
  display:flex; align-items:center; justify-content:space-between; gap:18px; flex-wrap:wrap;
  padding: 14px 24px; border-bottom:1px solid var(--line-soft);
  background: rgba(0,0,0,0.2); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
}
.brand{ display:flex; align-items:center; gap:10px; }
.brand .dot{ width:8px; height:8px; border-radius:50%; background: var(--btc); box-shadow: 0 0 12px 2px rgba(247,147,26,0.8); }
.brand b{ font-size:18px; font-weight:600; letter-spacing:-0.01em; }
.brand span{ font-size:12.5px; color: var(--text-faint); border-left:1px solid var(--line); padding-left:10px; }
.tb-right{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.orgtag{
  font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-dim);
  background: rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1);
  padding: 5px 11px; border-radius: 100px;
  display:inline-flex; align-items:center; gap:7px;
}
.orgtag::before{ content:""; width:6px; height:6px; border-radius:50%; background: var(--eth); }
.who{ text-align:right; line-height:1.3; }
.who b{ display:block; font-size:13.5px; font-weight:500; }
.who span{ font-size:11.5px; color: var(--text-faint); }

/* ---------- shell ---------- */
.shell{ position:relative; z-index:10; display:grid; grid-template-columns: 236px minmax(0,1fr); gap:0; align-items:start; }
@media (max-width: 1000px){ .shell{ grid-template-columns: 1fr; } }
aside{
  border-right:1px solid var(--line-soft); padding: 22px 14px 60px;
  position: sticky; top: 0; align-self: start; max-height:100vh; overflow-y:auto;
}
@media (max-width: 1000px){ aside{ position:static; border-right:0; border-bottom:1px solid var(--line-soft); padding-bottom: 20px; max-height:none; } }
aside h6{
  font-family:'JetBrains Mono',monospace; font-size:10.5px; font-weight:500; letter-spacing:0.1em;
  color: var(--text-faint); margin: 20px 12px 8px; text-transform: uppercase;
}
aside h6:first-child{ margin-top:0; }
aside a{
  display:flex; align-items:center; justify-content:space-between; gap:10px;
  font-size:14px; color: var(--text-dim); padding: 9px 12px; border-radius:8px;
  transition: background .15s ease, color .15s ease; cursor:pointer;
}
aside a:hover{ background: rgba(255,255,255,0.04); color: var(--text); }
aside a.on{ background: rgba(140,157,252,0.1); color: var(--text); box-shadow: inset 2px 0 0 var(--eth); }
aside .ct{ font-family:'JetBrains Mono',monospace; font-size:11px; color: var(--text-faint); }
aside .ct.alert{ color: var(--red); }

main{ padding: 26px 26px 80px; min-width:0; }
@media (max-width: 620px){ main{ padding: 20px 16px 60px; } }
.page{ display:none; }
.page.on{ display:block; }
.page-hd{ margin-bottom:20px; }
.page-hd h1{ font-size:22px; font-weight:600; letter-spacing:-0.01em; margin:0 0 6px; }
.page-hd p{ font-size:13.5px; color: var(--text-dim); margin:0; max-width:62ch; line-height:1.55; }

/* ---------- search row ---------- */
.searchrow{ display:flex; gap:10px; flex-wrap:wrap; }
.searchrow input{
  flex: 1 1 320px; min-width: 0;
  font-family:'JetBrains Mono',monospace; font-size:13.5px; color: var(--text);
  background: rgba(255,255,255,0.03); border:1px solid var(--line); border-radius:10px;
  padding: 12px 15px; transition: border-color .2s ease, background .2s ease;
}
.searchrow input:focus{ border-color: rgba(140,157,252,0.5); background: rgba(255,255,255,0.05); }
.searchrow select{
  font-family:'Space Grotesk',sans-serif; font-size:13.5px; color: var(--text);
  background: rgba(255,255,255,0.03); border:1px solid var(--line); border-radius:10px; padding: 12px 13px;
}
.searchrow select option{ background: var(--bg-card); color: var(--text); }
.btn{
  font-family:'Space Grotesk',sans-serif; font-size:14px; font-weight:700; letter-spacing:-0.01em;
  color:#06060a; cursor:pointer; white-space:nowrap;
  background: linear-gradient(135deg, #8c9dfc 0%, #5f74f0 100%);
  border:1px solid rgba(255,255,255,0.2); border-radius:10px; padding: 12px 22px;
  box-shadow: 0 4px 20px -2px rgba(140,157,252,0.45), inset 0 1px 0 rgba(255,255,255,0.35);
  transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
}
.btn:hover{ transform: translateY(-1px); box-shadow: 0 8px 28px rgba(140,157,252,0.6), inset 0 1px 0 rgba(255,255,255,0.5); }
.btn-line{
  background: rgba(255,255,255,0.03); color: var(--text-dim); font-weight:500;
  border:1px solid var(--line); box-shadow:none;
}
.btn-line:hover{ background: rgba(255,255,255,0.07); color: var(--text); border-color: rgba(255,255,255,0.22); box-shadow:none; }
.btn-sm{ font-size:12.5px; padding: 7px 14px; border-radius:8px; }
.hint{ font-size:12.5px; color: var(--text-faint); margin: 12px 2px 0; line-height:1.55; }

/* ---------- verdict ---------- */
.verdict{
  margin-top: 22px; display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap;
  padding: 22px 26px; border-radius:14px;
  border:1px solid rgba(47,227,163,0.28);
  background: linear-gradient(135deg, rgba(47,227,163,0.09) 0%, rgba(255,255,255,0.03) 55%);
}
.verdict.risk{ border-color: rgba(255,92,122,0.32); background: linear-gradient(135deg, rgba(255,92,122,0.1) 0%, rgba(255,255,255,0.03) 55%); }
.verdict h2{ font-size: clamp(19px,2.2vw,24px); font-weight:600; letter-spacing:-0.01em; margin:0 0 8px; }
.verdict p{ font-size:14px; line-height:1.6; color: var(--text-dim); margin:0; max-width: 70ch; }
.verdict .addr{ font-family:'JetBrains Mono',monospace; color: var(--text); font-size:13px; }
.vscore{ text-align:right; flex:none; }
.vscore b{ display:block; font-size:26px; font-weight:600; color: var(--green); letter-spacing:-0.02em; }
.verdict.risk .vscore b{ color: var(--red); }
.vscore span{ font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-faint); }

/* ---------- panels ---------- */
.cols{ display:grid; grid-template-columns: minmax(0,1.55fr) minmax(0,1fr); gap:16px; margin-top:16px; align-items:start; }
@media (max-width: 1080px){ .cols{ grid-template-columns: 1fr; } }
.stack{ display:flex; flex-direction:column; gap:16px; }
.panel{
  background: rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.1); border-radius:14px;
  overflow:hidden; backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  box-shadow: 0 4px 32px rgba(0,0,0,0.3);
}
.panel-hd{
  display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
  padding: 15px 20px; border-bottom:1px solid var(--line-soft);
}
.panel-hd h3{ font-size:15px; font-weight:600; margin:0; letter-spacing:-0.01em; }
.panel-hd .meta{ font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-faint); }
.panel-bd{ padding: 20px; }
.panel-bd.tight{ padding: 20px 20px 2px; }
.panel-bd.flush{ padding:0; }

/* ---------- hop chain (reused) ---------- */
.hop{ display:grid; grid-template-columns: 26px 1fr; gap:14px; padding-bottom:20px; position:relative; }
.hop:not(:last-child)::before{
  content:""; position:absolute; left:12.5px; top:26px; bottom:2px; width:1px;
  background: linear-gradient(to bottom, rgba(255,255,255,0.16), rgba(255,255,255,0.05));
}
.dot{
  width:26px; height:26px; border-radius:50%; display:grid; place-items:center;
  font-family:'JetBrains Mono',monospace; font-size:11px;
  background: rgba(255,255,255,0.05); border:1px solid var(--line); color: var(--text-dim); z-index:1;
}
.dot.start{ background: rgba(255,92,122,0.14); border-color: rgba(255,92,122,0.45); color: var(--red); }
.dot.warn{ background: rgba(240,180,41,0.14); border-color: rgba(240,180,41,0.45); color: var(--amber); }
.dot.end{ background: rgba(47,227,163,0.14); border-color: rgba(47,227,163,0.45); color: var(--green); }
.addr{ font-family:'JetBrains Mono',monospace; font-size:13.5px; color: var(--text); margin-bottom:5px; }
.hop .meta{ font-size:12.5px; line-height:1.5; color: var(--text-faint); display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
.tag{ font-family:'JetBrains Mono',monospace; font-size:10.5px; padding:2px 7px; border-radius:4px; border:1px solid var(--line); color: var(--text-dim); }
.tag-red{ color: var(--red); background: rgba(255,92,122,0.1); border-color: rgba(255,92,122,0.25); }
.tag-amb{ color: var(--amber); background: rgba(240,180,41,0.1); border-color: rgba(240,180,41,0.25); }
.tag-grn{ color: var(--green); background: rgba(47,227,163,0.1); border-color: rgba(47,227,163,0.25); }
.tag-blu{ color: var(--eth); background: rgba(140,157,252,0.1); border-color: rgba(140,157,252,0.25); }

.integrity{
  display:flex; flex-wrap:wrap; gap:8px 22px; padding: 12px 20px;
  border-top:1px solid var(--line-soft); background: rgba(255,255,255,0.02);
  font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-faint);
}
.integrity b{ color: var(--text-dim); font-weight:500; }

/* ---------- findings (reused) ---------- */
.flag{ display:grid; grid-template-columns: 24px 1fr; gap:13px; padding: 13px 0; border-bottom:1px solid var(--line-soft); }
.flag:last-child{ border-bottom:0; padding-bottom:0; }
.flag:first-child{ padding-top:0; }
.ic{ width:24px; height:24px; border-radius:6px; display:grid; place-items:center; font-size:12px; font-weight:600; flex:none; }
.ic-grn{ background: rgba(47,227,163,0.12); border:1px solid rgba(47,227,163,0.3); color: var(--green); }
.ic-amb{ background: rgba(240,180,41,0.12); border:1px solid rgba(240,180,41,0.3); color: var(--amber); }
.ic-blu{ background: rgba(140,157,252,0.12); border:1px solid rgba(140,157,252,0.3); color: var(--eth); }
.ic-red{ background: rgba(255,92,122,0.12); border:1px solid rgba(255,92,122,0.3); color: var(--red); }
.flag .hd{ font-size:14px; line-height:1.45; margin-bottom:4px; }
.flag .sub{ font-size:12.5px; line-height:1.55; color: var(--text-faint); }

/* ---------- registry list (reused) ---------- */
.reg{ margin:0; display:grid; grid-template-columns: auto 1fr; gap: 12px 18px; align-items:baseline; }
.reg dt{ font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-faint); }
.reg dd{ margin:0; font-size:13.5px; color: var(--text); text-align:right; }
.reg dd.mono{ font-family:'JetBrains Mono',monospace; font-size:12.5px; color: var(--text-dim); }
.reg dd.ok{ color: var(--green); }

/* ---------- action rows (reused) ---------- */
.act{
  display:flex; align-items:center; justify-content:space-between; gap:14px;
  padding: 13px 0; border-bottom:1px solid var(--line-soft);
}
.act:last-child{ border-bottom:0; padding-bottom:0; }
.act:first-child{ padding-top:0; }
.act .lbl{ font-size:13.5px; margin-bottom:3px; }
.act .sub{ font-size:12px; color: var(--text-faint); line-height:1.5; }
.done{
  font-family:'JetBrains Mono',monospace; font-size:11px; color: var(--green);
  background: rgba(47,227,163,0.1); border:1px solid rgba(47,227,163,0.28);
  padding: 5px 11px; border-radius:100px; white-space:nowrap;
}
.pending{ color: var(--amber); background: rgba(240,180,41,0.1); border-color: rgba(240,180,41,0.28); }
.blocked{ color: var(--red); background: rgba(255,92,122,0.1); border-color: rgba(255,92,122,0.28); }

/* ============================================================
   NEW — commercial-specific components (same visual language)
   ============================================================ */

/* KPI stat cards — Overview page */
.stats{ display:grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap:14px; }
@media (max-width: 900px){ .stats{ grid-template-columns: repeat(2, minmax(0,1fr)); } }
@media (max-width: 520px){ .stats{ grid-template-columns: 1fr; } }
.stat{
  background: rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.1); border-radius:14px;
  padding: 18px 20px; backdrop-filter: blur(24px);
}
.stat .lbl{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.04em; color: var(--text-faint); text-transform:uppercase; margin-bottom:10px; }
.stat .val{ font-size:26px; font-weight:600; letter-spacing:-0.02em; margin-bottom:4px; }
.stat .delta{ font-size:12px; color: var(--text-dim); }
.stat .delta.up{ color: var(--green); }
.stat .delta.warn{ color: var(--amber); }

/* Data table — History page */
.tbl-wrap{ overflow-x:auto; }
table.tbl{ width:100%; border-collapse:collapse; font-size:13px; }
table.tbl th{
  font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:0.06em; text-transform:uppercase;
  color: var(--text-faint); text-align:left; padding: 12px 20px; border-bottom:1px solid var(--line-soft); white-space:nowrap;
}
table.tbl td{ padding: 14px 20px; border-bottom:1px solid var(--line-soft); vertical-align:middle; white-space:nowrap; }
table.tbl tr:last-child td{ border-bottom:0; }
table.tbl tr:hover td{ background: rgba(255,255,255,0.02); }
.risk-pill{ font-family:'JetBrains Mono',monospace; font-size:10.5px; padding:3px 9px; border-radius:100px; display:inline-block; }
.risk-low{ color: var(--green); background: rgba(47,227,163,0.1); border:1px solid rgba(47,227,163,0.28); }
.risk-med{ color: var(--amber); background: rgba(240,180,41,0.1); border:1px solid rgba(240,180,41,0.28); }
.risk-high{ color: var(--red); background: rgba(255,92,122,0.1); border:1px solid rgba(255,92,122,0.28); }

/* Alert list — Risk Alerts page */
.alert-row{
  display:grid; grid-template-columns: 40px 1fr auto; gap:16px; align-items:center;
  padding: 16px 20px; border-bottom:1px solid var(--line-soft);
}
.alert-row:last-child{ border-bottom:0; }
.alert-row .ic{ width:36px; height:36px; border-radius:9px; font-size:15px; }
.alert-row .addr{ margin-bottom:3px; }
.alert-row .sub{ font-size:12.5px; color: var(--text-faint); }
.alert-actions{ display:flex; gap:8px; flex:none; }

/* API key box — Integration page */
.key-box{
  display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap;
  padding: 14px 18px; border-radius:10px; background: rgba(255,255,255,0.03); border:1px solid var(--line);
}
.key-box code{ font-family:'JetBrains Mono',monospace; font-size:13px; color: var(--text); letter-spacing:0.02em; }
pre.snippet{
  background: #0a0a12; border:1px solid var(--line); border-radius:10px; padding: 16px 18px;
  font-family:'JetBrains Mono',monospace; font-size:12.5px; line-height:1.7; color: #c7cbe0; overflow-x:auto; margin:0;
}
pre.snippet .k{ color: #8c9dfc; }
pre.snippet .s{ color: #2fe3a3; }
pre.snippet .c{ color: #5c5c6c; }

/* Team members — Team page */
.member{ display:flex; align-items:center; gap:14px; padding: 14px 20px; border-bottom:1px solid var(--line-soft); }
.member:last-child{ border-bottom:0; }
.avatar{
  width:36px; height:36px; border-radius:50%; flex:none; display:grid; place-items:center;
  font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:600;
  background: rgba(140,157,252,0.14); border:1px solid rgba(140,157,252,0.35); color: var(--eth);
}
.member .name{ font-size:13.5px; margin-bottom:2px; }
.member .email{ font-size:12px; color: var(--text-faint); font-family:'JetBrains Mono',monospace; }
.role-badge{
  font-family:'JetBrains Mono',monospace; font-size:10.5px; padding:4px 10px; border-radius:100px;
  background: rgba(255,255,255,0.05); border:1px solid var(--line); color: var(--text-dim); margin-left:auto;
}
.role-badge.owner{ color: var(--btc); background: rgba(247,147,26,0.1); border-color: rgba(247,147,26,0.28); }

/* Plan / usage bar */
.usagebar{ height:10px; border-radius:100px; background: rgba(255,255,255,0.06); overflow:hidden; border:1px solid var(--line); }
.usagebar i{ display:block; height:100%; background: linear-gradient(90deg, #8c9dfc, #5f74f0); }
.plan-row{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:8px; font-size:13px; }
.plan-row b{ font-family:'JetBrains Mono',monospace; font-weight:500; }

.empty{ padding: 30px 20px; text-align:center; color: var(--text-faint); font-size:13px; }

/* ---------- Attribution graph (SVG node-link view) ---------- */
.graph-toggle{ display:flex; gap:6px; }
.graph-toggle button{
  font-family:'JetBrains Mono',monospace; font-size:11px; padding:5px 10px; border-radius:7px;
  background: rgba(255,255,255,0.03); border:1px solid var(--line); color: var(--text-faint); cursor:pointer;
}
.graph-toggle button.on{ background: rgba(140,157,252,0.12); border-color: rgba(140,157,252,0.4); color: var(--eth); }
.graph-view{ padding: 10px 8px 4px; }
.graph-view svg{ width:100%; height:auto; display:block; }
.gnode-label{ font-family:'JetBrains Mono',monospace; font-size:11px; fill: var(--text-dim); }
.gnode-sub{ font-family:'Space Grotesk',sans-serif; font-size:10px; fill: var(--text-faint); }
.gedge-label{ font-family:'JetBrains Mono',monospace; font-size:9.5px; fill: var(--text-faint); }
.view-swap .list-view{ display:none; }
.view-swap.list .list-view{ display:block; }
.view-swap.list .graph-view{ display:none; }

/* ---------- Trace AI — floating assistant ---------- */
.ai-fab{
  position: fixed; right: 26px; bottom: 26px; z-index: 100;
  width: 58px; height: 58px; border-radius: 50%; border: 1px solid rgba(47,227,163,0.4);
  background: linear-gradient(135deg, #2fe3a3 0%, #1fae7d 100%);
  display:grid; place-items:center; cursor:pointer;
  box-shadow: 0 6px 24px -2px rgba(47,227,163,0.55), inset 0 1px 0 rgba(255,255,255,0.35);
  transition: transform .15s ease, box-shadow .15s ease;
}
.ai-fab:hover{ transform: translateY(-2px) scale(1.03); box-shadow: 0 10px 30px rgba(47,227,163,0.7); }
.ai-fab svg{ width:24px; height:24px; }
.ai-fab .pulse{
  position:absolute; inset:-6px; border-radius:50%; border:1px solid rgba(47,227,163,0.35);
  animation: ai-pulse 2.4s ease-out infinite;
}
@keyframes ai-pulse{ 0%{ transform:scale(0.85); opacity:0.9; } 100%{ transform:scale(1.35); opacity:0; } }
@media (prefers-reduced-motion: reduce){ .ai-fab .pulse{ animation:none; display:none; } }

.ai-panel{
  position: fixed; right: 26px; bottom: 96px; z-index: 100;
  width: 380px; max-width: calc(100vw - 40px); height: 520px; max-height: 70vh;
  background: var(--bg-card); border:1px solid rgba(255,255,255,0.12); border-radius:16px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.55); backdrop-filter: blur(24px);
  display:none; flex-direction:column; overflow:hidden;
}
.ai-panel.open{ display:flex; }
@media (max-width: 460px){ .ai-panel{ right:12px; left:12px; width:auto; bottom:88px; } .ai-fab{ right:18px; bottom:18px; } }
.ai-hd{
  display:flex; align-items:center; gap:10px; padding: 14px 16px; border-bottom:1px solid var(--line-soft);
  background: rgba(47,227,163,0.06);
}
.ai-hd .ai-dot{ width:8px; height:8px; border-radius:50%; background: var(--green); box-shadow: 0 0 10px 2px rgba(47,227,163,0.7); }
.ai-hd b{ font-size:13.5px; }
.ai-hd span{ font-size:11px; color: var(--text-faint); display:block; }
.ai-hd .close{ margin-left:auto; cursor:pointer; color: var(--text-faint); font-size:18px; line-height:1; padding:4px; }
.ai-hd .close:hover{ color: var(--text); }
.ai-body{ flex:1; overflow-y:auto; padding: 14px 16px; display:flex; flex-direction:column; gap:12px; }
.ai-msg{ display:flex; gap:9px; max-width:92%; }
.ai-msg.user{ align-self:flex-end; flex-direction:row-reverse; }
.ai-avatar{
  width:24px; height:24px; border-radius:50%; flex:none; display:grid; place-items:center; font-size:11px;
  background: rgba(47,227,163,0.14); border:1px solid rgba(47,227,163,0.35); color: var(--green);
}
.ai-msg.user .ai-avatar{ background: rgba(140,157,252,0.14); border-color: rgba(140,157,252,0.35); color: var(--eth); }
.ai-bubble{
  font-size:12.5px; line-height:1.6; padding: 9px 12px; border-radius:12px;
  background: rgba(255,255,255,0.04); border:1px solid var(--line-soft); color: var(--text);
}
.ai-msg.user .ai-bubble{ background: rgba(140,157,252,0.1); border-color: rgba(140,157,252,0.25); }
.ai-cite{
  display:inline-flex; align-items:center; justify-content:center; min-width:16px; height:16px; padding:0 4px;
  margin: 0 2px; border-radius:5px; background: rgba(47,227,163,0.2); border:1px solid rgba(47,227,163,0.35);
  color:#a8f5da; font-family:'JetBrains Mono',monospace; font-size:9.5px; vertical-align:super; cursor:pointer;
}
.ai-suggested{ display:flex; flex-wrap:wrap; gap:6px; padding: 4px 16px 12px; border-bottom:1px solid var(--line-soft); }
.ai-chip{
  font-family:'JetBrains Mono',monospace; font-size:10.5px; padding: 6px 10px; border-radius:100px;
  background: rgba(255,255,255,0.03); border:1px solid var(--line); color: var(--text-dim); cursor:pointer;
  transition: background .15s ease, color .15s ease;
}
.ai-chip:hover{ background: rgba(47,227,163,0.1); color: var(--green); border-color: rgba(47,227,163,0.3); }
.ai-input-row{ display:flex; gap:8px; padding: 12px 14px; border-top:1px solid var(--line-soft); }
.ai-input-row input{
  flex:1; font-family:'Space Grotesk',sans-serif; font-size:12.5px; color: var(--text);
  background: rgba(255,255,255,0.03); border:1px solid var(--line); border-radius:10px; padding: 9px 12px;
}
.ai-send{
  width:36px; height:36px; border-radius:9px; flex:none; display:grid; place-items:center; cursor:pointer;
  background: linear-gradient(135deg, #2fe3a3, #1fae7d); border:1px solid rgba(255,255,255,0.2);
}

/* ---------- Batch screening (CSV upload) ---------- */
.dropzone{
  border: 1.5px dashed rgba(255,255,255,0.16); border-radius:14px; padding: 40px 20px; text-align:center;
  background: rgba(255,255,255,0.02); transition: border-color .2s ease, background .2s ease; cursor:pointer;
}
.dropzone:hover{ border-color: rgba(140,157,252,0.45); background: rgba(140,157,252,0.04); }
.dropzone .ico{ font-size:28px; margin-bottom:10px; }
.dropzone .ttl{ font-size:14px; margin-bottom:4px; }
.dropzone .sub{ font-size:12px; color: var(--text-faint); }
.batch-row{ display:grid; grid-template-columns: 1fr auto auto; gap:14px; align-items:center; padding:13px 20px; border-bottom:1px solid var(--line-soft); }
.batch-row:last-child{ border-bottom:0; }
.progress{ width:120px; height:6px; border-radius:100px; background: rgba(255,255,255,0.08); overflow:hidden; }
.progress i{ display:block; height:100%; background: linear-gradient(90deg,#8c9dfc,#5f74f0); }
</style>
</head>
