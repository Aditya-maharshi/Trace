/* ============================================================
   Trace Landing CSS — theme carried over unchanged from the
   deployed build (apps/web/src/styles.css, "Trace Landing CSS")
   ============================================================ */
:root{
  --bg: #06060a;
  --bg-raised: #0d0d15;
  --bg-card: #101019;
  --line: rgba(255,255,255,0.08);
  --btc: #f7931a;
  --eth: #8c9dfc;
  --sol: #14f1c6;
  --green: #2fe3a3;
  --red: #ff5c7a;
  --amber: #f0b429;
  --text: #f2f2f7;
  --text-dim: #9a9aab;
  --text-faint: #5c5c6c;
}
.gov-landing-root{
  box-sizing: border-box;
  background: var(--bg);
  color: var(--text);
  font-family: 'Space Grotesk', sans-serif;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  min-height: 100vh;
}
.gov-landing-root *, .gov-landing-root *::before, .gov-landing-root *::after{ box-sizing: border-box; }
.gov-landing-root .mono{ font-family: 'JetBrains Mono', monospace; }
.gov-landing-root a{ color: inherit; text-decoration: none; }
.gov-landing-root a:focus-visible, .gov-landing-root button:focus-visible, .gov-landing-root input:focus-visible, .gov-landing-root select:focus-visible{ outline: 2px solid var(--btc); outline-offset: 3px; }
@media (prefers-reduced-motion: reduce){
  .gov-landing-root *{ animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}
.gov-landing-root .wrap{ max-width: 1180px; margin: 0 auto; padding: 0 32px; }
.gov-landing-root .gov-landing-root section{ position: relative; }

/* ---------- .gov-landing-root nav ---------- */
.gov-landing-root header{
  position: fixed; top:0; left:0; right:0; z-index: 50;
  background: linear-gradient(to bottom, rgba(6,6,10,0.94), rgba(6,6,10,0));
  backdrop-filter: blur(6px);
}
.advisory{
  background: rgba(247,147,26,0.07);
  border-bottom: 1px solid rgba(247,147,26,0.22);
  font-family:'JetBrains Mono',monospace; font-size:11.5px; line-height:1.5;
  color: #e8ba7d; padding: 7px 32px; text-align:center;
}
.advisory b{ color: var(--btc); font-weight:500; }
.gov-landing-root nav{ max-width: 1180px; margin: 0 auto; padding: 18px 32px; display:flex; align-items:center; justify-content: space-between; gap: 20px; }
.logo{ font-size: 19px; font-weight: 600; letter-spacing: -0.01em; display:flex; align-items:center; gap:8px; }
.logo::before{ content:""; width:8px; height:8px; border-radius:50%; background: var(--btc); box-shadow: 0 0 12px 2px var(--btc); }
.logo .sub{ font-size:11.5px; font-weight:400; color: var(--text-faint); border-left:1px solid var(--line); padding-left:9px; margin-left:2px; }
@media (max-width: 980px){ .logo .sub{ display:none; } }
.nav-links{ display:flex; gap:32px; font-size:14.5px; color: var(--text-dim); }
.nav-links a:hover{ color: var(--text); }
.nav-cta{ font-size:14px; padding:9px 18px; border:1px solid var(--line); border-radius:6px; color: var(--text); white-space:nowrap; transition: border-color .2s ease, background .2s ease; }
.nav-cta:hover{ border-color: var(--btc); background: rgba(247,147,26,0.08); }
@media (max-width: 860px){ .nav-links{ display:none; } }

/* ---------- hero ---------- */
.hero{
  min-height:100vh; display:flex; align-items:center; position:relative;
  padding: 150px 0 120px;
  background: radial-gradient(ellipse 70% 60% at 62% 45%, rgba(247,147,26,0.08), transparent 70%),
              radial-gradient(ellipse 60% 60% at 20% 80%, rgba(140,157,252,0.07), transparent 70%);
}
#hero-canvas{ position:absolute; inset:0; z-index:0; touch-action: pan-y; }
@media (hover:hover) and (pointer:fine){ #hero-canvas{ cursor: grab; } #hero-canvas:active{ cursor: grabbing; } }

/* The React <LandingScene> canvas is `position:absolute; inset:0` and reads
   canvas.parentElement's clientWidth/clientHeight to size the WebGL renderer.
   Without this rule .hero-scene-container is a plain block div with no
   height (its only child is taken out of flow), so clientHeight reads 0 and
   the component falls back to a hardcoded 580px render height while CSS still
   stretches the canvas to the full ~100vh hero — producing a squashed,
   mis-scaled scene and a raycaster whose hit-testing no longer lines up with
   what's on screen. Making this container fill and match .hero fixes both. */
.hero-scene-container{ position:absolute; inset:0; z-index:0; }
.hero-vignette{
  position:absolute; inset:0; z-index:1; pointer-events:none;
  background: radial-gradient(ellipse 85% 80% at 50% 48%, rgba(6,6,10,0) 0%, rgba(6,6,10,0.55) 82%, rgba(6,6,10,0.92) 100%);
}
.hero-grid{
  position:relative; z-index:2;
  display:grid; grid-template-columns: minmax(0,1.05fr) minmax(0,0.95fr);
  gap: 56px; align-items:center; width:100%;
}
@media (max-width: 1000px){ .hero-grid{ grid-template-columns: 1fr; gap: 44px; } }
.hero-content{ max-width: 620px; }
.eyebrow-tag{
  display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace; font-size:12.5px;
  color: var(--btc); border:1px solid rgba(247,147,26,0.32); background: rgba(247,147,26,0.07);
  padding:6px 12px; border-radius:100px; margin-bottom:26px;
}
.eyebrow-tag .dot{ width:6px; height:6px; border-radius:50%; background: var(--green); animation: blink 1.6s ease-in-out infinite; }
@keyframes blink{ 0%,100%{opacity:1;} 50%{opacity:0.25;} }
.hero h1{ font-size: clamp(36px, 4.9vw, 56px); line-height:1.06; letter-spacing:-0.02em; font-weight:600; margin:0 0 22px; }
.hero .lede{ font-size:18px; line-height:1.6; color: var(--text-dim); max-width:500px; margin:0 0 18px; }
.hero .sub{ font-size:15px; line-height:1.68; color: var(--text-faint); max-width:520px; margin:0 0 32px; }
.hero-actions{ display:flex; gap:14px; align-items:center; flex-wrap:wrap; margin-bottom: 18px; }
.btn-primary{
  position: relative; z-index: 10;
  background: linear-gradient(135deg, #f7931a 0%, #e07a05 100%);
  color: #06060a; font-weight: 700; font-size: 15px; letter-spacing: -0.01em;
  padding: 13px 26px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2);
  box-shadow: 0 4px 20px -2px rgba(247,147,26,0.45), inset 0 1px 0 rgba(255,255,255,0.35);
  display: inline-flex; align-items: center; gap: 8px; cursor:pointer;
  font-family:'Space Grotesk',sans-serif;
  transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
}
.btn-primary:hover{
  transform: translateY(-2px);
  background: linear-gradient(135deg, #ff9f1c 0%, #f7931a 100%);
  box-shadow: 0 8px 30px rgba(247,147,26,0.65), inset 0 1px 0 rgba(255,255,255,0.5);
}
.btn-ghost{
  font-size: 14.5px; font-weight: 500; color: var(--text-dim);
  padding: 12px 20px; border-radius: 8px;
  background: rgba(255,255,255,0.03); border: 1px solid var(--line);
  backdrop-filter: blur(10px); display: inline-flex; align-items: center; gap: 6px;
  transition: color .15s ease, border-color .15s ease, background .15s ease, transform .15s ease;
}
.btn-ghost:hover{ color: var(--text); border-color: rgba(255,255,255,0.25); background: rgba(255,255,255,0.07); transform: translateY(-1px); }
.hero-note{ font-size:13px; color: var(--text-faint); margin:0; }
.hero-hint{
  position:absolute; top: 118px; right: 40px; z-index:2;
  font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-faint);
  display:flex; align-items:center; gap:8px; pointer-events:none;
}
@media (hover:none), (pointer:coarse), (max-width: 1000px){ .hero-hint{ display:none; } }
.hero-hint .ring{ width:8px; height:8px; border:1px solid var(--text-faint); border-radius:50%; }

/* ---------- hero docket panel ---------- */
.docket{
  background: rgba(13,13,21,0.88);
  backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
  border: 1px solid rgba(255,255,255,0.1); border-radius: 12px;
  box-shadow: 0 18px 48px -12px rgba(0,0,0,0.75), inset 0 1px 0 rgba(255,255,255,0.06);
  overflow:hidden;
}
.docket-hd{
  display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
  padding: 13px 18px; border-bottom:1px solid var(--line);
  font-family:'JetBrains Mono',monospace; font-size:11.5px;
}
.docket-hd .no{ color: var(--text-dim); letter-spacing:0.02em; }
.docket-hd .st{ color: var(--green); }
.chain{ padding: 20px 18px 6px; }
.hop{ display:grid; grid-template-columns: 26px 1fr; gap:14px; padding-bottom: 20px; position:relative; }
.hop:not(:last-child)::before{
  content:""; position:absolute; left:12.5px; top:26px; bottom:2px; width:1px;
  background: linear-gradient(to bottom, rgba(255,255,255,0.16), rgba(255,255,255,0.05));
}
.dot{
  width:26px; height:26px; border-radius:50%; display:grid; place-items:center;
  font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:500;
  background: rgba(255,255,255,0.05); border:1px solid var(--line); color: var(--text-dim); z-index:1;
}
.dot.start{ background: rgba(255,92,122,0.14); border-color: rgba(255,92,122,0.45); color: var(--red); }
.dot.mix{ background: rgba(240,180,41,0.14); border-color: rgba(240,180,41,0.45); color: var(--amber); }
.dot.end{ background: rgba(47,227,163,0.14); border-color: rgba(47,227,163,0.45); color: var(--green); }
.addr{ font-family:'JetBrains Mono',monospace; font-size:13.5px; color: var(--text); margin-bottom:5px; }
.hop .meta{ font-size:12.5px; line-height:1.5; color: var(--text-faint); display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
.tag{
  font-family:'JetBrains Mono',monospace; font-size:10.5px; padding:2px 7px; border-radius:4px;
