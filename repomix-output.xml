    position: absolute; bottom: 32px; right: max(4vw, 32px); left: auto; z-index: 2;
    display: inline-flex; align-items: center; gap: 14px;
    background: rgba(13, 13, 21, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    padding: 7px 18px;
    box-shadow: 0 8px 32px -4px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    pointer-events: auto;
    user-select: none;
  }
  .ticker-pill{
    display: flex; align-items: center; gap: 7px;
    padding-right: 12px; border-right: 1px solid rgba(255, 255, 255, 0.1);
  }
  .pulse-dot{
    width: 7px; height: 7px; border-radius: 50%;
    background: #2fe3a3;
    box-shadow: 0 0 10px #2fe3a3;
    animation: ticker-pulse 2s infinite ease-in-out;
  }
  @keyframes ticker-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }
  .ticker-label{
    font-family: 'JetBrains Mono', monospace; font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.08em; color: var(--text-dim); text-transform: uppercase;
  }
  .hero-ticker .t-item{
    display: flex; align-items: center; gap: 8px;
  }
  .hero-ticker .t-item .sym{
    font-family: var(--font-sans); font-size: 12px; font-weight: 700;
    color: var(--text-dim); letter-spacing: 0.04em;
  }
  .hero-ticker .t-item .val{
    font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums;
    font-size: 13px; font-weight: 600; color: #ffffff;
    letter-spacing: -0.01em;
  }
  .hero-ticker .t-item .chg{
    font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums;
    font-size: 11px; font-weight: 600; padding: 2px 6px; border-radius: 4px;
    letter-spacing: -0.01em;
  }
  .hero-ticker .t-item .chg.up, #coin-info .ci-change.up{
    color: #2fe3a3; background: rgba(47, 227, 163, 0.12);
    border: 1px solid rgba(47, 227, 163, 0.25);
  }
  .hero-ticker .t-item .chg.down, #coin-info .ci-change.down{
    color: #ff5c7a; background: rgba(255, 92, 122, 0.12);
    border: 1px solid rgba(255, 92, 122, 0.25);
  }
  .t-divider{
    width: 1px; height: 14px; background: rgba(255, 255, 255, 0.08);
  }
  @media (max-width: 760px){
    .hero-content{ margin-top: 80px; margin-bottom: 80px; margin-left: 0; padding: 0 20px; }
    .hero-ticker{
      bottom: 16px; left: 16px; right: 16px;
      overflow-x: auto; border-radius: 12px;
      justify-content: center;
      max-width: calc(100vw - 32px);
    }
  }

  /* coin info card that follows the selected coin */
  #coin-info{
    position: absolute; z-index: 3; transform: translate(-50%, -120%);
    background: rgba(10, 10, 18, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 14px 18px; min-width: 180px;
    opacity: 0; pointer-events: none; transition: opacity .18s ease, transform .18s ease;
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.8);
  }
  #coin-info.visible{ opacity: 1; transform: translate(-50%, -125%); }
  #coin-info .ci-header{
    display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px;
  }
  #coin-info .ci-name{
    font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: #ffffff;
  }
  #coin-info .ci-sym{
    font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 600;
    color: var(--text-dim); background: rgba(255, 255, 255, 0.06);
    padding: 1px 6px; border-radius: 4px;
  }
  #coin-info .ci-price{
    font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums;
    font-size: 18px; font-weight: 700; color: #ffffff; margin-bottom: 6px;
    letter-spacing: -0.02em;
  }
  #coin-info .ci-change{
    display: inline-flex; align-items: center; gap: 4px;
    font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums;
    font-size: 11.5px; font-weight: 600; padding: 2px 7px; border-radius: 5px;
  }

  /* ---------- section headers ---------- */
  .section-head{ max-width: 540px; margin: 0 0 56px; }
  .section-kicker{ font-family:'JetBrains Mono',monospace; font-size:12.5px; color: var(--eth); margin:0 0 14px; }
  .section-head h2{ font-size: clamp(26px, 3.4vw, 36px); line-height:1.2; letter-spacing:-0.01em; font-weight:600; margin:0 0 16px; }
  .section-head p{ color: var(--text-dim); font-size:16px; line-height:1.65; margin:0; }

  /* ---------- track section ---------- */
  .track{ padding: 140px 0 120px; border-top: 1px solid var(--line); }
  .track-grid{ display:grid; grid-template-columns: repeat(2, 1fr); gap:1px; background: var(--line); border:1px solid var(--line); perspective: 900px; }
  @media (max-width: 720px){ .track-grid{ grid-template-columns: 1fr; } }
  .track-card{
    background: var(--bg); padding: 34px 32px; position:relative;
    transition: transform .12s ease, background .2s ease;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .track-card:hover{ background: #08080e; }
  .track-card .tag{ font-family:'JetBrains Mono',monospace; font-size:12px; color: var(--text-faint); display:block; margin-bottom:18px; }
  .track-card h3{ font-size:19px; font-weight:600; margin:0 0 10px; }
  .track-card p{ font-size:14.5px; line-height:1.6; color: var(--text-dim); margin:0; max-width:360px; }
  .trace-spark{ width:100%; height:34px; margin-top:22px; display:block; }

  /* ---------- inspector / portfolio mockup ---------- */
  .inspector-section{ padding: 0 0 140px; }
  .inspector{ background: var(--bg-card); border:1px solid var(--line); border-radius:10px; overflow:hidden; }
  .inspector-bar{
    display:flex; align-items:center; gap:10px; padding:14px 18px; border-bottom:1px solid var(--line);
    font-family:'JetBrains Mono',monospace; font-size:12.5px; color: var(--text-faint);
  }
  .inspector-bar .traffic{ display:flex; gap:6px; margin-right:8px; }
  .inspector-bar .traffic span{ width:9px; height:9px; border-radius:50%; background: rgba(255,255,255,0.12); }
  .inspector-bar #total-value{ color: var(--text); }
  .inspector-#trace-landing-root{ display:grid; grid-template-columns: 260px 1fr; }
  @media (max-width: 760px){ .inspector-#trace-landing-root{ grid-template-columns: 1fr; } }
  .inspector-tree{ border-right:1px solid var(--line); padding:18px 8px; font-family:'JetBrains Mono',monospace; font-size:12.5px; }
  .tree-row{ display:flex; align-items:center; justify-content: space-between; gap:8px; padding:9px 12px; border-radius:5px; color: var(--text-dim); cursor:default; transition: background .15s ease; }
  .tree-row:hover{ background: rgba(255,255,255,0.03); }
  .tree-row.active{ background: rgba(247,147,26,0.08); color: var(--text); }
  .tree-row .left{ display:flex; align-items:center; gap:8px; }
  .tree-row .badge{ width:6px; height:6px; border-radius:50%; flex-shrink:0; }
  .b-btc{ background: var(--btc); }
  .b-eth{ background: var(--eth); }
  .b-alt{ background: var(--text-faint); }
  .tree-row .chg.up{ color: var(--green); }
  .tree-row .chg.down{ color: var(--red); }

  .inspector-waterfall{ padding: 22px 24px; }
  .wf-row{ display:grid; grid-template-columns: 100px 1fr 110px; align-items:center; gap:14px; padding:9px 0; font-family:'JetBrains Mono',monospace; font-size:12px; color: var(--text-dim); }
  .wf-label{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .wf-track{ position:relative; height:6px; background: rgba(255,255,255,0.05); border-radius:3px; overflow:hidden; }
  .wf-bar{ position:absolute; top:0; bottom:0; left:0; border-radius:3px; width:0%; transition: width 1s cubic-bezier(.2,.8,.2,1); }
  .wf-time{ text-align:right; color: var(--text-faint); }

  /* ---------- how it works ---------- */
  .how{ padding: 0 0 140px; }
  .how-steps{ display:grid; grid-template-columns: repeat(3, 1fr); gap:28px; }
  @media (max-width: 820px){ .how-steps{ grid-template-columns: 1fr; } }
  .how-step{ padding:28px 26px; border:1px solid var(--line); border-radius:10px; background: var(--bg-raised); transition: border-color .2s ease; }
  .how-step:hover{ border-color: rgba(247,147,26,0.35); }
  .how-step .num{ font-family:'JetBrains Mono',monospace; font-size:13px; color: var(--btc); margin-bottom:20px; display:block; }
  .how-step h3{ font-size:17px; font-weight:600; margin:0 0 10px; }
  .how-step p{ font-size:14.5px; color: var(--text-dim); line-height:1.6; margin:0; }

  /* ---------- cta ---------- */
  .cta-section{ padding: 60px 0 160px; }
  .cta-box{
    text-align:center; padding: 72px 32px; border:1px solid var(--line); border-radius:14px;
    background: radial-gradient(ellipse 60% 100% at 50% 0%, rgba(140,157,252,0.14), transparent), var(--bg-raised);
  }
  .cta-box h2{ font-size: clamp(26px, 3.6vw, 38px); font-weight:600; letter-spacing:-0.01em; margin:0 0 16px; }
  .cta-box p{ color: var(--text-dim); font-size:16px; margin:0 0 34px; }
  .cta-platforms{ display:flex; gap:14px; justify-content:center; flex-wrap:wrap; margin-bottom: 30px; }
  .platform-pill{
    font-family:'JetBrains Mono',monospace; font-size:12.5px; color: var(--text-dim);
    border:1px solid var(--line); padding:9px 16px; border-radius:100px;
  }

  /* ---------- footer ---------- */
  footer{ border-top:1px solid var(--line); padding: 40px 0; }
  .footer-row{ display:flex; align-items:center; justify-content: space-between; flex-wrap:wrap; gap:18px; }
  .footer-row .logo{ font-size:15px; }
  footer .foot-links{ display:flex; gap:26px; font-size:13.5px; color: var(--text-faint); }
  footer .foot-links a:hover{ color: var(--text-dim); }
  footer .copyright{ font-size:12.5px; color: var(--text-faint); }

/* ---------- Case Management Board & SLA Degradation ---------- */
.case-card--warning {
  border-left: 3px solid #f59e0b !important;
  background: linear-gradient(90deg, rgba(245, 158, 11, 0.06) 0%, transparent 40%), rgba(255, 255, 255, 0.04) !important;
}

.case-card--breached {
  border-left: 3px solid #ef4444 !important;
  background: linear-gradient(90deg, rgba(239, 68, 68, 0.08) 0%, transparent 40%), rgba(255, 255, 255, 0.04) !important;
  animation: sla-breach-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes sla-breach-pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
  }
  50% {
    box-shadow: 0 0 12px 1px rgba(239, 68, 68, 0.25);
  }
}

@media (prefers-reduced-motion: reduce) {
  .case-card--breached {
    animation: none !important;
    box-shadow: 0 0 8px 1px rgba(239, 68, 68, 0.2) !important;
  }
}
