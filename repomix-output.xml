<file path="apps/web/src/features/government/dashboard/views/FundFlowGraphView.tsx">
/**
 * features/government/dashboard/views/FundFlowGraphView.tsx
 *
 * Force-directed fund-flow graph using @xyflow/react (already in package.json).
 *
 * Renders the trace result's `graph` field (nodes + edges from
 * buildAttributionResponse → buildGraphVisualizationPayload) as an interactive
 * React Flow diagram.
 *
 * ### Node color scheme
 *   wallet      → #6b7280 (gray-500)
 *   vasp        → #22c55e (green-500) — nearest regulated entity
 *   mixer       → #ef4444 (red-500)  — OFAC-designated
 *   bridge      → #f97316 (orange-500) — cross-chain exit
 *   sanctioned  → #dc2626 (red-600 + dashed ring)
 *
 * ### Edge width
 * Proportional to log(1 + valueUSD) — matches the attribution scoring formula
 * so high-value flows are visually prominent without drowning out small transfers.
 *
 * ### Investigative lead notice
 * Rendered as a non-dismissable overlay at the top of the graph. This is not
 * optional — every surface that shows attribution data must include it.
 */

"use client";

import React, { useCallback, useMemo } from "react";
import {
  ReactFlow,
  Background,
  Controls,
  MiniMap,
  Handle,
  Position,
  type NodeTypes,
  type Node,
  type Edge,
  type NodeProps,
} from "@xyflow/react";
import "@xyflow/react/dist/style.css";
import type { AttributionResponse } from "@sih/shared-types";

// ─────────────────────────────────────────────────────────────────────────────
// Color scheme
// ─────────────────────────────────────────────────────────────────────────────

const NODE_COLORS: Record<string, string> = {
  wallet: "#374151",
  vasp: "#16a34a",
  mixer: "#dc2626",
  bridge: "#ea580c",
  sanctioned: "#991b1b",
};

const NODE_BORDER: Record<string, string> = {
  wallet: "#6b7280",
  vasp: "#22c55e",
  mixer: "#ef4444",
  bridge: "#f97316",
  sanctioned: "#7f1d1d",
};

// ─────────────────────────────────────────────────────────────────────────────
// Custom node component
// ─────────────────────────────────────────────────────────────────────────────

interface TraceNodeData extends Record<string, unknown> {
  label: string;
  type: "wallet" | "vasp" | "mixer" | "bridge" | "sanctioned";
  address: string;
}

function TraceNode({ data }: NodeProps) {
  const nodeData = data as TraceNodeData;
  const bg = NODE_COLORS[nodeData.type] ?? NODE_COLORS.wallet;
  const border = NODE_BORDER[nodeData.type] ?? NODE_BORDER.wallet;
  const isSanctioned = nodeData.type === "sanctioned";

  return (
    <div
      style={{
        background: bg,
        border: `2px ${isSanctioned ? "dashed" : "solid"} ${border}`,
        borderRadius: nodeData.type === "vasp" ? "12px" : "6px",
        padding: "8px 12px",
        minWidth: 140,
        maxWidth: 220,
        color: "#ffffff",
        fontSize: 11,
        boxShadow: nodeData.type === "vasp"
          ? "0 0 0 3px rgba(34,197,94,0.25)"
          : nodeData.type === "sanctioned"
          ? "0 0 0 3px rgba(239,68,68,0.35)"
          : undefined,
      }}
    >
      <Handle type="target" position={Position.Left} style={{ background: border }} />

      <div style={{ fontWeight: 700, fontSize: 10, opacity: 0.7, textTransform: "uppercase", letterSpacing: 0.8, marginBottom: 2 }}>
        {nodeData.type}
      </div>

      {nodeData.label && (
        <div style={{ fontWeight: 600, fontSize: 12, marginBottom: 2 }}>
          {nodeData.label}
        </div>
      )}

      <div style={{ fontFamily: "monospace", fontSize: 9, opacity: 0.75 }}>
        {nodeData.address.slice(0, 8)}…{nodeData.address.slice(-4)}
      </div>

      <Handle type="source" position={Position.Right} style={{ background: border }} />
    </div>
  );
}

const nodeTypes: NodeTypes = {
  traceNode: TraceNode,
};

// ─────────────────────────────────────────────────────────────────────────────
// Graph layout helper (simple left-to-right layered layout)
// ─────────────────────────────────────────────────────────────────────────────

function layoutNodes(
  nodes: AttributionResponse["graph"]["nodes"],
  edges: AttributionResponse["graph"]["edges"],
): Node[] {
  // Group nodes by approximate hop distance from first node
  const hopDepth = new Map<string, number>();
  const sourceId = nodes[0]?.id;
  if (sourceId) hopDepth.set(sourceId, 0);

  // BFS over edges to assign depth
  const queue = [sourceId].filter(Boolean);
  while (queue.length > 0) {
    const current = queue.shift()!;
    const currentDepth = hopDepth.get(current) ?? 0;
    for (const edge of edges) {
      if (edge.source === current && !hopDepth.has(edge.target)) {
        hopDepth.set(edge.target, currentDepth + 1);
        queue.push(edge.target);
      }
    }
  }

  // Group nodes by depth
  const byDepth = new Map<number, string[]>();
  for (const node of nodes) {
    const depth = hopDepth.get(node.id) ?? 0;
    if (!byDepth.has(depth)) byDepth.set(depth, []);
    byDepth.get(depth)!.push(node.id);
  }

  const NODE_WIDTH = 200;
  const NODE_HEIGHT = 90;
  const H_GAP = 80;
  const V_GAP = 30;

  const positioned: Node[] = [];
  for (const node of nodes) {
    const depth = hopDepth.get(node.id) ?? 0;
    const column = byDepth.get(depth)!;
    const rowIndex = column.indexOf(node.id);
    const totalRows = column.length;
    const y = (rowIndex - (totalRows - 1) / 2) * (NODE_HEIGHT + V_GAP);

    positioned.push({
      id: node.id,
      type: "traceNode",
      position: { x: depth * (NODE_WIDTH + H_GAP), y },
      data: {
        label: node.label ?? "",
        type: node.type,
        address: node.id,
      },
    });
  }
  return positioned;
}

// ─────────────────────────────────────────────────────────────────────────────
// Edge width from value
// ─────────────────────────────────────────────────────────────────────────────

function edgeWidth(valueUSD: number): number {
  // log(1 + value) — same formula as attribution scoring
  // Map to 1–6px range
  const raw = Math.log1p(valueUSD);
  return Math.min(Math.max(raw / 5, 1), 6);
}

// ─────────────────────────────────────────────────────────────────────────────
// Main component
// ─────────────────────────────────────────────────────────────────────────────

interface FundFlowGraphViewProps {
  attribution: AttributionResponse;
}

export function FundFlowGraphView({ attribution }: FundFlowGraphViewProps) {
  const graph = attribution.graph;

  const rfNodes = useMemo((): Node[] => {
    if (!graph?.nodes?.length) return [];
    return layoutNodes(graph.nodes, graph.edges ?? []);
  }, [graph]);

  const rfEdges = useMemo((): Edge[] => {
    if (!graph?.edges?.length) return [];
    return graph.edges.map((e, idx) => ({
      id: `e-${idx}`,
      source: e.source,
      target: e.target,
      label: e.valueUSD > 0 ? `$${e.valueUSD >= 1000 ? `${(e.valueUSD / 1000).toFixed(1)}k` : e.valueUSD.toFixed(0)}` : undefined,
      labelStyle: { fill: "#9ca3af", fontSize: 9 },
      style: {
        strokeWidth: edgeWidth(e.valueUSD),
        stroke: "#4b5563",
      },
      animated: e.valueUSD > 10_000, // animate high-value flows
    }));
  }, [graph]);

  if (!graph?.nodes?.length) {
    return (
      <div className="flex items-center justify-center h-64 text-gray-400 text-sm">
        No graph data available — run a trace first.
      </div>
    );
  }

  return (
    <div className="relative flex flex-col h-full">
      {/* Mandatory investigative-lead notice */}
      <div className="flex items-center gap-2 px-3 py-1.5 bg-amber-950/60 border-b border-amber-700/40 text-amber-300 text-xs font-medium shrink-0">
        <span className="text-amber-500">⚠</span>
        Investigative lead — confidence scores require VASP confirmation before use in court.
        {graph.truncated && (
          <span className="ml-auto text-orange-400">Graph truncated — full traversal available in report</span>
        )}
      </div>

      {/* React Flow canvas */}
      <div className="flex-1">
        <ReactFlow
          nodes={rfNodes}
          edges={rfEdges}
          nodeTypes={nodeTypes}
          fitView
          fitViewOptions={{ padding: 0.2 }}
          minZoom={0.3}
          maxZoom={2}
          attributionPosition="bottom-left"
        >
          <Background color="#1f2937" gap={20} size={1} />
          <Controls className="!bg-gray-800 !border-gray-700" />
          <MiniMap
            nodeColor={(n) => {
              const nodeData = n.data as TraceNodeData;
              return NODE_COLORS[nodeData?.type] ?? "#374151";
            }}
            maskColor="rgba(0,0,0,0.4)"
            style={{ background: "#111827" }}
          />
        </ReactFlow>
      </div>

      {/* Legend */}
      <div className="flex gap-4 px-3 py-2 bg-gray-900/80 border-t border-gray-800 text-xs shrink-0 flex-wrap">
        {Object.entries(NODE_COLORS).map(([type, color]) => (
          <div key={type} className="flex items-center gap-1.5">
            <div className="w-3 h-3 rounded-sm" style={{ background: color }} />
            <span className="text-gray-400 capitalize">{type}</span>
          </div>
        ))}
        <div className="ml-auto text-gray-500">Edge width ∝ transaction value</div>
      </div>
    </div>
  );
}
