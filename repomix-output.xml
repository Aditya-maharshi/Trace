        }

        window.location.href = data.url;
      } else {
        setLoading(false);
      }
    } catch (err) {
      setLoading(false);
      setError(err instanceof Error ? err.message : "Failed to initiate Google sign-in.");
      setOauthFallbackProvider("google");
    }
  }

