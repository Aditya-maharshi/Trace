  .hero p{ font-size:18px; line-height:1.6; color: var(--text-dim); max-width:470px; margin:0 0 36px; }
  .hero-actions{ display:flex; gap:14px; align-items:center; flex-wrap:wrap; margin-bottom: 12px; }
  .btn-primary{
