  }
  .btn-ghost{
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text-dim);
    padding: 12px 20px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
    backdrop-filter: blur(10px);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color .15s ease, border-color .15s ease, background .15s ease, transform .15s ease;
  }
  .btn-ghost:hover{
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.07);
    transform: translateY(-1px);
  }

  .hero-hint{
    position:absolute; top: 100px; right: 40px; z-index:2;
    font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-faint);
    display:flex; align-items:center; gap:8px; pointer-events:none;
  }
  @media (hover:none), (pointer:coarse){ .hero-hint{ display:none; } }
  .hero-hint .ring{ width:8px; height:8px; border:1px solid var(--text-faint); border-radius:50%; }

  /* ---------- hero ticker ---------- */
  .hero-ticker{
    position: absolute; bottom: 32px; right: max(4vw, 32px); left: auto; z-index: 2;
    display: inline-flex; align-items: center; gap: 14px;
    background: rgba(13, 13, 21, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    padding: 7px 18px;
    box-shadow: 0 8px 32px -4px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    pointer-events: auto;
    user-select: none;
  }
  .ticker-pill{
    display: flex; align-items: center; gap: 7px;
    padding-right: 12px; border-right: 1px solid rgba(255, 255, 255, 0.1);
  }
  .pulse-dot{
    width: 7px; height: 7px; border-radius: 50%;
    background: #2fe3a3;
    box-shadow: 0 0 10px #2fe3a3;
    animation: ticker-pulse 2s infinite ease-in-out;
