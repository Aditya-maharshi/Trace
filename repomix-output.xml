      <div class="ai-bubble">This wallet was flagged <b>High risk</b> because the origin address matched an OFAC sanctions entry<span class="ai-cite">1</span> and hop 1 shows prior exposure to a known mixing service<span class="ai-cite">2</span>. No regulated VASP was reached within 2 hops.</div>
    </div>
  </div>
  <div class="ai-input-row">
    <input type="text" placeholder="Ask about this trace…" id="aiInput" onkeydown="if(event.key==='Enter'){sendAI();}">
    <div class="ai-send" onclick="sendAI()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#06060a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
    </div>
  </div>
</div>

<script>
function toggleAI(){ document.getElementById('aiPanel').classList.toggle('open'); }
function appendAI(role, text){
  var body = document.getElementById('aiBody');
  var msg = document.createElement('div');
  msg.className = 'ai-msg' + (role === 'user' ? ' user' : '');
  msg.innerHTML = '<div class="ai-avatar">' + (role === 'user' ? 'AM' : '✦') + '</div><div class="ai-bubble">' + text + '</div>';
  body.appendChild(msg);
  body.scrollTop = body.scrollHeight;
}
var AI_REPLIES = {
  "Why is this flagged high risk?": "Two independent signals triggered it: a direct sanctions-list match<span class=\"ai-cite\">1</span> and a mixer-adjacent hop<span class=\"ai-cite\">2</span>. Either alone would raise the score; together they push it to High.",
  "Is this safe to onboard?": "No — based on the current screening, this address should not be onboarded without manual compliance review. The sanctions match alone is normally a hard block under most VASP policies.",
  "What does mixer-adjacent mean?": "It means an address one hop away has prior transaction history with a known mixing/tumbling service, which is often used to break the traceability of funds — it doesn't confirm wrongdoing by itself, but it's a recognized risk signal."
};
function askAI(el){
  var q = el.textContent;
  if(!document.getElementById('aiPanel').classList.contains('open')) toggleAI();
  appendAI('user', q);
  setTimeout(function(){ appendAI('assistant', AI_REPLIES[q] || "Let me look into that for this trace."); }, 500);
}
function sendAI(){
  var input = document.getElementById('aiInput');
  var val = input.value.trim();
  if(!val) return;
  appendAI('user', val);
  input.value = '';
  setTimeout(function(){ appendAI('assistant', "I can only speak to what the attribution engine found on this trace — for anything outside this result, check the case notes or ask a senior analyst."); }, 500);
}
function setPathView(mode, btn){
  var panel = document.getElementById('pathPanel');
  panel.classList.toggle('list', mode === 'list');
  btn.parentElement.querySelectorAll('button').forEach(function(b){ b.classList.remove('on'); });
  btn.classList.add('on');
}
</script>

<script>
function showPage(id){
  document.querySelectorAll('.page').forEach(function(p){ p.classList.remove('on'); });
  document.querySelectorAll('aside a[data-page]').forEach(function(a){ a.classList.remove('on'); });
  var page = document.getElementById('page-' + id);
  var link = document.querySelector('aside a[data-page="' + id + '"]');
  if(page) page.classList.add('on');
  if(link) link.classList.add('on');
}
document.querySelectorAll('aside a[data-page]').forEach(function(a){
  a.addEventListener('click', function(){ showPage(a.getAttribute('data-page')); });
});
</script>

