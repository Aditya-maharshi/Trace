  }

  async getTransactions(address: string, pageSize = 100): Promise<Transaction[]> {
    // Fetch one extra row so callers can tell a hot wallet's history was truncated.
    const rows = await fetchAccountEndpoint<Transaction>(
      this.baseUrl,
      this.apiKey,
      this.limiter,
      this.name,
