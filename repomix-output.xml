  async function sendAi(question: string) {
    const q = question.trim();
    if (!q) return;

    if (aiBusy && aiAbortController.current) {
      aiAbortController.current.abort();
      aiAbortController.current = null;
    }

    const abortController = new AbortController();
    aiAbortController.current = abortController;

    setAiMsgs((m) => [...m, { role: "user", text: q }, { role: "assistant", text: "" }]);
    setAiInput("");
    setAiBusy(true);

    try {
      if (!data) {
        setAiMsgs((m) => {
          const newM = [...m];
          const last = newM[newM.length - 1];
          if (last) last.text = "Screen a wallet first — I can only explain a live attribution result.";
          return newM;
        });
        setAiBusy(false);
        return;
      }

      await askFollowUp(
        q,
        data,
        (token) => {
          setAiMsgs((m) => {
            const newM = [...m];
            const last = newM[newM.length - 1];
            if (last) last.text += token;
            return newM;
          });
        },
        abortController.signal
      );
    } catch (err: any) {
      if (err.name !== "AbortError") {
        setAiMsgs((m) => {
          const newM = [...m];
          const last = newM[newM.length - 1];
          if (last) last.text = err instanceof Error ? err.message : "Trace AI could not answer that.";
          return newM;
        });
      }
    } finally {
      if (aiAbortController.current === abortController) {
        setAiBusy(false);
        aiAbortController.current = null;
      }
    }
  }

