        var hit = hits.length ? hits[0].object : null;
        if (hit !== hovered){
          hovered = hit;
          canvas.style.cursor = hit ? 'pointer' : (isTouch ? 'default' : 'grab');
          coinObjects.forEach(function(c){ c.targetScale = (c.mesh === hovered) ? 1.35 : 1; });
        }
      });
      canvas.addEventListener('pointerdown', function(e){ downPos = { x:e.clientX, y:e.clientY }; });
      canvas.addEventListener('pointerup', function(e){
        if (!downPos) return;
        var dist = Math.hypot(e.clientX - downPos.x, e.clientY - downPos.y);
        downPos = null;
        if (dist > 6) return;
        ndcFromEvent(e);
        raycaster.setFromCamera(pointerNDC, camera);
        var hits = raycaster.intersectObjects(clickableMeshes, false);
        if (hits.length){
          selected = hits[0].object;
          var d = selected.userData;
          var elName = document.getElementById('ci-name');
          var elSym = document.getElementById('ci-sym');
          var elPrice = document.getElementById('ci-price');
          var elChange = document.getElementById('ci-change');
          if (elName) elName.textContent = d.name;
          if (elSym) elSym.textContent = d.symbol;
          if (elPrice) elPrice.textContent = d.price;
          if (elChange) {
            elChange.textContent = (d.up ? '▲ +' : '▼ -') + d.change;
            elChange.className = 'ci-change ' + (d.up ? 'up' : 'down');
          }
          if (infoCard) infoCard.classList.add('visible');
