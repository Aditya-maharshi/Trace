<file path="src/features/commercial/landing/landing.module.css">
/* src/components/landing/landing.module.css */
/* Scoped CSS extracted from index.html with dark theme and precision crypto forensics styling */

.landingRoot {
  --btc: #f7931a;
  --eth: #8c9dfc;
  --sol: #14f1c6;
  --green: #2fe3a3;
  --red: #ff5c7a;
  --bg: #06060a;
  --bg-raised: #0d0d15;
  --bg-card: #101019;
  --line: rgba(255, 255, 255, 0.08);
  --text: #f2f2f7;
  --text-dim: #9a9aab;
  --text-faint: #5c5c6c;

  background: var(--bg);
  color: var(--text);
  font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  overflow-x: hidden;
  width: 100%;
}

.mono {
  font-family: 'JetBrains Mono', monospace;
}

.wrap {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 32px;
}

/* ---------- Header & Nav ---------- */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: linear-gradient(to bottom, rgba(6, 6, 10, 0.92), rgba(6, 6, 10, 0));
  backdrop-filter: blur(8px);
}

.nav {
  max-width: 1180px;
  margin: 0 auto;
  padding: 22px 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.02em;
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
}

.coinBadge {
  width: 20px;
  height: 20px;
  perspective: 180px;
  flex-shrink: 0;
}

.spin {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  animation: coinSpin 3s linear infinite;
}

.face {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  backface-visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  font-family: 'JetBrains Mono', monospace;
  color: #3a2205;
  background: radial-gradient(circle at 32% 28%, #ffd98a, var(--btc) 55%, #7a4a10 100%);
  box-shadow: 0 0 8px 1px rgba(247, 147, 26, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.25);
}

.faceBack {
  transform: rotateY(180deg);
  background: radial-gradient(circle at 32% 28%, #d8e0ff, var(--eth) 55%, #4c5aa8 100%);
  color: #141a3d;
}

@keyframes coinSpin {
  0% { transform: rotateY(0deg) rotateX(10deg); }
  100% { transform: rotateY(360deg) rotateX(10deg); }
}

.navLinks {
  display: flex;
  gap: 28px;
  align-items: center;
  font-size: 14px;
  color: var(--text-dim);
}

.navLinks a {
  transition: color 0.15s ease;
}

.navLinks a:hover {
  color: var(--text);
}

.navCta {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12.5px;
  background: var(--text);
  color: #06060a;
  padding: 8px 16px;
  border-radius: 6px;
  font-weight: 600;
  transition: transform 0.15s ease, background 0.15s ease;
}

.navCta:hover {
  transform: translateY(-1px);
  background: #ffffff;
}

/* Hamburger button — hidden on desktop */
.hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
  min-width: 44px;
  min-height: 44px;
  align-items: center;
}

.hLine {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--text);
  border-radius: 2px;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.hLineOpen1 {
  transform: translateY(7px) rotate(45deg);
}

.hLineOpen2 {
  opacity: 0;
}

.hLineOpen3 {
  transform: translateY(-7px) rotate(-45deg);
}

/* Mobile dropdown menu */
.mobileMenu {
  display: flex;
  flex-direction: column;
  gap: 0;
  background: rgba(6, 6, 10, 0.98);
  backdrop-filter: blur(16px);
  border-top: 1px solid var(--line);
  padding: 16px 24px 24px;
}

.mobileMenu a {
  display: block;
  font-size: 16px;
  color: var(--text-dim);
  padding: 12px 0;
  border-bottom: 1px solid var(--line);
  transition: color 0.15s ease;
  min-height: 44px;
  display: flex;
  align-items: center;
}

.mobileMenu a:last-child {
  border-bottom: none;
  margin-top: 12px;
  justify-content: center;
}

.mobileMenu a:hover {
  color: var(--text);
}

@media (max-width: 680px) {
  .navLinks {
    display: none;
  }
  .navCtaDesktop {
    display: none;
  }
  .hamburger {
    display: flex;
  }
}


/* ---------- Hero ---------- */
.hero {
  min-height: 100vh;
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 120px 0 80px;
}

.heroVignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(ellipse 70% 60% at 50% 50%, transparent 20%, rgba(6, 6, 10, 0.85) 75%, var(--bg) 100%);
