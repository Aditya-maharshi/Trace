import React from 'react';

interface CoinInfoPanelProps {
  node: { name: string; label: string; score: string } | null;
  className?: string;
}

export function CoinInfoPanel({ node, className = '' }: CoinInfoPanelProps) {
  if (!node) return null;

  // Expected name format: "Bitcoin (BTC)"
  const nameMatch = node.name.match(/(.+)\s+\((.+)\)/);
  const name = nameMatch ? nameMatch[1] : node.name;
  const sym = nameMatch ? nameMatch[2] : '';

  const isUp = node.score.startsWith('+');
  const isDown = node.score.startsWith('-');
  const changeClass = isUp ? 'up' : isDown ? 'down' : '';
  const scoreDisplay = isUp || isDown ? (isUp ? `▲ ${node.score.substring(1)}` : `▼ ${node.score.substring(1)}`) : node.score;

  return (
    <div id="coin-info" className={`visible ${className}`} style={{
        position: 'absolute', zIndex: 3, transform: 'translate(-50%, -125%)', left: '50%', top: '50%',
        background: 'rgba(10,10,18,0.94)',
        backdropFilter: 'blur(20px)', WebkitBackdropFilter: 'blur(20px)',
        border: '1px solid rgba(255,255,255,0.12)', borderRadius: '12px',
        padding: '14px 18px', minWidth: '190px',
        boxShadow: '0 16px 36px -8px rgba(0,0,0,0.8), 0 0 24px rgba(247,147,26,0.12)',
        color: '#fff',
        fontFamily: "'Space Grotesk', sans-serif"
    }}>
      <div className="ci-header" style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '8px', marginBottom: '4px' }}>
        <span className="ci-name" style={{ fontSize: '14px', fontWeight: 600 }}>{name}</span>
        {sym && <span className="ci-sym" style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: '11px', fontWeight: 600, color: '#9a9aab', background: 'rgba(255,255,255,0.06)', padding: '1px 6px', borderRadius: '4px' }}>{sym}</span>}
      </div>
      <div className="ci-price" style={{ fontFamily: "'JetBrains Mono', monospace", fontVariantNumeric: 'tabular-nums', fontSize: '17px', fontWeight: 700, marginBottom: '6px', letterSpacing: '-0.02em' }}>
        {node.label}
      </div>
      <div className="ci-change" style={{
          display: 'inline-flex', alignItems: 'center', gap: '4px', fontFamily: "'JetBrains Mono', monospace",
          fontSize: '11.5px', fontWeight: 600, padding: '2px 7px', borderRadius: '5px',
          ...(isUp ? { color: '#2fe3a3', background: 'rgba(47,227,163,0.12)', border: '1px solid rgba(47,227,163,0.25)' } :
              isDown ? { color: '#ff5c7a', background: 'rgba(255,92,122,0.12)', border: '1px solid rgba(255,92,122,0.25)' } : {})
      }}>
        {scoreDisplay}
      </div>
    </div>
  );
}
