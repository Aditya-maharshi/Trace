<file path="src/features/government/dashboard/views/SahyogView.tsx">
import { ShieldAlert, RefreshCw } from "lucide-react";
import { useSahyogQueue } from "@/hooks/useSahyogQueue";

export function SahyogView() {
  const { queue, loading, error, refetch } = useSahyogQueue();

  return (
    <div style={{ padding: "0 26px 80px", width: "100%" }}>
      <div className="flex items-center justify-between mb-8">
        <div>
          <h1 className="text-2xl font-semibold flex items-center gap-2">
            <ShieldAlert className="h-6 w-6 text-indigo-400" />
            SAHYOG Dispatch Queue
          </h1>
          <p className="text-white/50 text-sm mt-1">Prepared payloads awaiting portal credentials.</p>
        </div>
        <div className="flex items-center gap-4">
          <button onClick={refetch} className="p-2 hover:bg-white/10 rounded-full transition-colors text-white/50 hover:text-white" title="Refresh">
            <RefreshCw className={`h-4 w-4 ${loading ? 'animate-spin' : ''}`} />
          </button>
        </div>
      </div>

      {error && (
        <div className="bg-red-500/10 border border-red-500/30 text-red-400 p-4 rounded-xl mb-6">
          {error}
        </div>
      )}

      <div className="bg-white/[0.02] border border-white/10 rounded-xl overflow-hidden">
        <table className="w-full text-left text-sm" style={{ borderCollapse: 'collapse' }}>
          <thead className="bg-white/[0.04] border-b border-white/10">
            <tr>
              <th className="px-4 py-3 font-medium text-white/70">Date</th>
              <th className="px-4 py-3 font-medium text-white/70">Case ID</th>
              <th className="px-4 py-3 font-medium text-white/70">VASP</th>
              <th className="px-4 py-3 font-medium text-white/70">Target Wallet</th>
              <th className="px-4 py-3 font-medium text-white/70">Status</th>
            </tr>
          </thead>
          <tbody>
            {queue.length === 0 && !loading && (
              <tr>
                <td colSpan={5} className="px-4 py-8 text-center text-white/40">
                  No payloads in the queue.
                </td>
              </tr>
            )}
            {queue.map((entry) => (
              <tr key={entry.id} className="border-b border-white/5 last:border-0 hover:bg-white/[0.02] transition-colors">
                <td className="px-4 py-3 text-white/60 whitespace-nowrap">
                  {new Date(entry.created_at).toLocaleString()}
                </td>
                <td className="px-4 py-3 font-mono text-white/80">{entry.case_id?.split("-")[0]}...</td>
                <td className="px-4 py-3 font-medium">{entry.metadata?.attributedVasp}</td>
                <td className="px-4 py-3 font-mono text-white/60 text-xs">{entry.metadata?.targetAddress}</td>
                <td className="px-4 py-3">
                  <span className="inline-flex items-center px-2 py-1 rounded bg-yellow-500/10 text-yellow-400 text-[10px] uppercase font-semibold tracking-wider">
                    Prepared (Not Transmitted)
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
</file>

<file path="src/features/government/dashboard/government-dashboard.css">
/* ============================================================
   Theme carried over unchanged from the deployed dashboard:
   #06060a base, ambient orange/blue glow, grid overlay,
   white/5 glass panels, Space Grotesk + JetBrains Mono.
   ============================================================ */
:root{
  --bg: #06060a;
  --bg-raised: #0d0d15;
  --bg-card: #101019;
  --line: rgba(255,255,255,0.08);
  --line-soft: rgba(255,255,255,0.05);
  --btc: #f7931a;
  --eth: #8c9dfc;
  --green: #2fe3a3;
  --red: #ff5c7a;
  --amber: #f0b429;
  --text: #f2f2f7;
  --text-dim: #9a9aab;
  --text-faint: #5c5c6c;
}
.gov-dashboard-root{
  min-height: 100vh;
  background: var(--bg); color: var(--text);
  font-family:'Space Grotesk', sans-serif;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
.gov-dashboard-root *, .gov-dashboard-root *::before, .gov-dashboard-root *::after{ box-sizing: border-box; }
.gov-dashboard-root a{ color: inherit; text-decoration: none; }
.gov-dashboard-root a:focus-visible, .gov-dashboard-root button:focus-visible, .gov-dashboard-root input:focus-visible, .gov-dashboard-root select:focus-visible{ outline: 2px solid var(--btc); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce){
  .gov-dashboard-root *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }
}
.gov-dashboard-root .mono{ font-family:'JetBrains Mono', monospace; }

/* ---------- ambient background ---------- */
.ambient{ position: fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
.ambient .orb-a{ position:absolute; top:-25%; left:-25%; width:70vw; height:70vw; border-radius:50%; background: rgba(247,147,26,0.10); filter: blur(160px); }
.ambient .orb-b{ position:absolute; bottom:-25%; right:-25%; width:70vw; height:70vw; border-radius:50%; background: rgba(140,157,252,0.10); filter: blur(160px); }
.ambient .grid{
  position:absolute; inset:0; opacity:0.035;
  background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px);
  background-size: 60px 60px;
}

/* ---------- advisory ---------- */
.advisory{
  position: relative; z-index: 30;
  background: rgba(247,147,26,0.07); border-bottom: 1px solid rgba(247,147,26,0.22);
  font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#e8ba7d;
  padding: 7px 24px; text-align:center;
}
.advisory b{ color: var(--btc); font-weight:500; }

/* ---------- topbar ---------- */
.topbar{
  position: relative; z-index: 20;
  display:flex; align-items:center; justify-content:space-between; gap:18px; flex-wrap:wrap;
  padding: 14px 24px; border-bottom:1px solid var(--line-soft);
  background: rgba(0,0,0,0.2); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
}
.brand{ display:flex; align-items:center; gap:10px; }
.brand .dot{ width:8px; height:8px; border-radius:50%; background: var(--btc); box-shadow: 0 0 12px 2px rgba(247,147,26,0.8); }
.brand b{ font-size:18px; font-weight:600; letter-spacing:-0.01em; }
.brand span{ font-size:12.5px; color: var(--text-faint); border-left:1px solid var(--line); padding-left:10px; }
.tb-right{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.agency{
  font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-dim);
  background: rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1);
  padding: 5px 11px; border-radius: 100px;
  display:inline-flex; align-items:center; gap:7px;
}
.agency::before{ content:""; width:6px; height:6px; border-radius:50%; background: var(--green); }
.who{ text-align:right; line-height:1.3; }
.who b{ display:block; font-size:13.5px; font-weight:500; }
.who span{ font-size:11.5px; color: var(--text-faint); }

/* ---------- shell ---------- */
.shell{ position:relative; z-index:10; display:grid; grid-template-columns: 236px minmax(0,1fr); gap:0; align-items:start; }
@media (max-width: 1000px){ .shell{ grid-template-columns: 1fr; } }
.gov-dashboard-root aside{
  border-right:1px solid var(--line-soft); padding: 22px 14px 60px;
  position: sticky; top: 0; align-self: start;
}
@media (max-width: 1000px){ .gov-dashboard-root aside{ position:static; border-right:0; border-bottom:1px solid var(--line-soft); padding-bottom: 20px; } }
.gov-dashboard-root aside h6{
  font-family:'JetBrains Mono',monospace; font-size:10.5px; font-weight:500; letter-spacing:0.1em;
  color: var(--text-faint); margin: 20px 12px 8px; text-transform: uppercase;
}
.gov-dashboard-root aside h6:first-child{ margin-top:0; }
.gov-dashboard-root aside a{
  display:flex; align-items:center; justify-content:space-between; gap:10px;
  font-size:14px; color: var(--text-dim); padding: 9px 12px; border-radius:8px;
  transition: background .15s ease, color .15s ease;
}
.gov-dashboard-root aside a:hover{ background: rgba(255,255,255,0.04); color: var(--text); }
.gov-dashboard-root aside a.on{ background: rgba(247,147,26,0.1); color: var(--text); box-shadow: inset 2px 0 0 var(--btc); }
.gov-dashboard-root aside .ct{ font-family:'JetBrains Mono',monospace; font-size:11px; color: var(--text-faint); }

.gov-dashboard-root main{ padding: 26px 26px 80px; min-width:0; }
@media (max-width: 620px){ .gov-dashboard-root main{ padding: 20px 16px 60px; } }

/* ---------- search row ---------- */
.searchrow{ display:flex; gap:10px; flex-wrap:wrap; }
.searchrow input{
  flex: 1 1 320px; min-width: 0;
  font-family:'JetBrains Mono',monospace; font-size:13.5px; color: var(--text);
  background: rgba(255,255,255,0.03); border:1px solid var(--line); border-radius:10px;
  padding: 12px 15px; transition: border-color .2s ease, background .2s ease;
}
.searchrow input:focus{ border-color: rgba(247,147,26,0.5); background: rgba(255,255,255,0.05); }
.searchrow select{
  font-family:'Space Grotesk',sans-serif; font-size:13.5px; color: var(--text);
  background: rgba(255,255,255,0.03); border:1px solid var(--line); border-radius:10px; padding: 12px 13px;
}
.searchrow select option{ background: var(--bg-card); color: var(--text); }
.btn{
  font-family:'Space Grotesk',sans-serif; font-size:14px; font-weight:700; letter-spacing:-0.01em;
  color:#06060a; cursor:pointer; white-space:nowrap;
  background: linear-gradient(135deg, #f7931a 0%, #e07a05 100%);
  border:1px solid rgba(255,255,255,0.2); border-radius:10px; padding: 12px 22px;
  box-shadow: 0 4px 20px -2px rgba(247,147,26,0.45), inset 0 1px 0 rgba(255,255,255,0.35);
  transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
}
.btn:hover{ transform: translateY(-1px); background: linear-gradient(135deg,#ff9f1c 0%,#f7931a 100%); box-shadow: 0 8px 28px rgba(247,147,26,0.6), inset 0 1px 0 rgba(255,255,255,0.5); }
.btn-line{
  background: rgba(255,255,255,0.03); color: var(--text-dim); font-weight:500;
  border:1px solid var(--line); box-shadow:none;
}
.btn-line:hover{ background: rgba(255,255,255,0.07); color: var(--text); border-color: rgba(255,255,255,0.22); box-shadow:none; }
.btn-sm{ font-size:12.5px; padding: 7px 14px; border-radius:8px; }
.hint{ font-size:12.5px; color: var(--text-faint); margin: 12px 2px 0; line-height:1.55; }

/* ---------- verdict ---------- */
.verdict{
  margin-top: 22px; display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap;
  padding: 22px 26px; border-radius:14px;
  border:1px solid rgba(47,227,163,0.28);
  background: linear-gradient(135deg, rgba(47,227,163,0.09) 0%, rgba(255,255,255,0.03) 55%);
}
.verdict h2{ font-size: clamp(20px,2.4vw,25px); font-weight:600; letter-spacing:-0.01em; margin:0 0 8px; }
.verdict p{ font-size:14px; line-height:1.6; color: var(--text-dim); margin:0; max-width: 70ch; }
.verdict .addr{ font-family:'JetBrains Mono',monospace; color: var(--text); font-size:13px; }
.vscore{ text-align:right; flex:none; }
.vscore b{ display:block; font-size:26px; font-weight:600; color: var(--green); letter-spacing:-0.02em; }
.vscore span{ font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-faint); }

/* ---------- panels ---------- */
.cols{ display:grid; grid-template-columns: minmax(0,1.55fr) minmax(0,1fr); gap:16px; margin-top:16px; align-items:start; }
@media (max-width: 1080px){ .cols{ grid-template-columns: 1fr; } }
.stack{ display:flex; flex-direction:column; gap:16px; }
.panel{
  background: rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.1); border-radius:14px;
  overflow:hidden; backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  box-shadow: 0 4px 32px rgba(0,0,0,0.3);
}
.panel-hd{
  display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
  padding: 15px 20px; border-bottom:1px solid var(--line-soft);
}
.panel-hd h3{ font-size:15px; font-weight:600; margin:0; letter-spacing:-0.01em; }
.panel-hd .meta{ font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-faint); }
.panel-bd{ padding: 20px; }
.panel-bd.tight{ padding: 20px 20px 2px; }

/* ---------- hop chain ---------- */
.hop{ display:grid; grid-template-columns: 26px 1fr; gap:14px; padding-bottom:20px; position:relative; }
.hop:not(:last-child)::before{
  content:""; position:absolute; left:12.5px; top:26px; bottom:2px; width:1px;
  background: linear-gradient(to bottom, rgba(255,255,255,0.16), rgba(255,255,255,0.05));
}
.dot{
  width:26px; height:26px; border-radius:50%; display:grid; place-items:center;
  font-family:'JetBrains Mono',monospace; font-size:11px;
  background: rgba(255,255,255,0.05); border:1px solid var(--line); color: var(--text-dim); z-index:1;
}
.dot.start{ background: rgba(255,92,122,0.14); border-color: rgba(255,92,122,0.45); color: var(--red); }
.dot.warn{ background: rgba(240,180,41,0.14); border-color: rgba(240,180,41,0.45); color: var(--amber); }
.dot.end{ background: rgba(47,227,163,0.14); border-color: rgba(47,227,163,0.45); color: var(--green); }
.addr{ font-family:'JetBrains Mono',monospace; font-size:13.5px; color: var(--text); margin-bottom:5px; }
.hop .meta{ font-size:12.5px; line-height:1.5; color: var(--text-faint); display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
.tag{ font-family:'JetBrains Mono',monospace; font-size:10.5px; padding:2px 7px; border-radius:4px; border:1px solid var(--line); color: var(--text-dim); }
.tag-red{ color: var(--red); background: rgba(255,92,122,0.1); border-color: rgba(255,92,122,0.25); }
.tag-amb{ color: var(--amber); background: rgba(240,180,41,0.1); border-color: rgba(240,180,41,0.25); }
.tag-grn{ color: var(--green); background: rgba(47,227,163,0.1); border-color: rgba(47,227,163,0.25); }
.tag-blu{ color: var(--eth); background: rgba(140,157,252,0.1); border-color: rgba(140,157,252,0.25); }

.integrity{
  display:flex; flex-wrap:wrap; gap:8px 22px; padding: 12px 20px;
  border-top:1px solid var(--line-soft); background: rgba(255,255,255,0.02);
  font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-faint);
}
.integrity b{ color: var(--text-dim); font-weight:500; }

/* ---------- taint bar ---------- */
.taint{ display:flex; height:36px; border-radius:8px; overflow:hidden; border:1px solid var(--line); }
.t-illicit{ flex: 0 0 68.4%; background: linear-gradient(90deg, rgba(255,92,122,0.85), rgba(255,92,122,0.55)); }
.t-clean{ flex:1; background: rgba(255,255,255,0.06); }
.taint-key{ display:flex; flex-wrap:wrap; gap: 10px 26px; margin-top:14px; font-size:13px; color: var(--text-dim); }
.taint-key span{ display:inline-flex; align-items:center; gap:8px; }
.taint-key b{ color: var(--text); font-weight:600; font-family:'JetBrains Mono',monospace; }
.sw{ width:10px; height:10px; border-radius:3px; display:inline-block; }

/* ---------- findings ---------- */
.flag{ display:grid; grid-template-columns: 24px 1fr; gap:13px; padding: 13px 0; border-bottom:1px solid var(--line-soft); }
.flag:last-child{ border-bottom:0; padding-bottom:0; }
.flag:first-child{ padding-top:0; }
.ic{ width:24px; height:24px; border-radius:6px; display:grid; place-items:center; font-size:12px; font-weight:600; }
.ic-grn{ background: rgba(47,227,163,0.12); border:1px solid rgba(47,227,163,0.3); color: var(--green); }
.ic-amb{ background: rgba(240,180,41,0.12); border:1px solid rgba(240,180,41,0.3); color: var(--amber); }
.ic-blu{ background: rgba(140,157,252,0.12); border:1px solid rgba(140,157,252,0.3); color: var(--eth); }
.flag .hd{ font-size:14px; line-height:1.45; margin-bottom:4px; }
.flag .sub{ font-size:12.5px; line-height:1.55; color: var(--text-faint); }

/* ---------- registry list ---------- */
.reg{ margin:0; display:grid; grid-template-columns: auto 1fr; gap: 12px 18px; align-items:baseline; }
.reg dt{ font-family:'JetBrains Mono',monospace; font-size:11.5px; color: var(--text-faint); }
.reg dd{ margin:0; font-size:13.5px; color: var(--text); text-align:right; }
.reg dd.mono{ font-family:'JetBrains Mono',monospace; font-size:12.5px; color: var(--text-dim); }
.reg dd.ok{ color: var(--green); }

/* ---------- action rows ---------- */
.act{
  display:flex; align-items:center; justify-content:space-between; gap:14px;
  padding: 13px 0; border-bottom:1px solid var(--line-soft);
}
.act:last-child{ border-bottom:0; padding-bottom:0; }
.act:first-child{ padding-top:0; }
.act .lbl{ font-size:13.5px; margin-bottom:3px; }
.act .sub{ font-size:12px; color: var(--text-faint); line-height:1.5; }
.done{
  font-family:'JetBrains Mono',monospace; font-size:11px; color: var(--green);
  background: rgba(47,227,163,0.1); border:1px solid rgba(47,227,163,0.28);
  padding: 5px 11px; border-radius:100px; white-space:nowrap;
}

/* ---------- case board ---------- */
.board{ display:grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap:14px; }
@media (max-width: 1000px){ .board{ grid-template-columns: repeat(2, minmax(0,1fr)); } }
@media (max-width: 600px){ .board{ grid-template-columns: 1fr; } }
.col h5{
  display:flex; align-items:center; justify-content:space-between;
  font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:500; letter-spacing:0.06em;
  color: var(--text-faint); text-transform: uppercase; margin: 0 0 12px; padding-bottom: 9px;
  border-bottom: 1px solid var(--line-soft);
}
.card{
  background: rgba(255,255,255,0.04); border:1px solid var(--line); border-radius:10px;
  padding: 13px 14px; margin-bottom:10px;
}
.card .cno{ font-family:'JetBrains Mono',monospace; font-size:11px; color: var(--text-faint); margin-bottom:6px; }
.card .ttl{ font-size:13.5px; line-height:1.4; margin-bottom:10px; }
.card .foot{ display:flex; justify-content:space-between; gap:10px; font-family:'JetBrains Mono',monospace; font-size:11px; color: var(--text-faint); }
.card .br{ color: var(--red); }
.card.sla{
  border-left:3px solid var(--amber);
  background: linear-gradient(90deg, rgba(240,180,41,0.07) 0%, transparent 40%), rgba(255,255,255,0.04);
}
.card.esc{
  border-left:3px solid var(--red);
  background: linear-gradient(90deg, rgba(255,92,122,0.08) 0%, transparent 40%), rgba(255,255,255,0.04);
  animation: sla-breach-pulse 2s cubic-bezier(0.4,0,0.6,1) infinite;
}
@keyframes sla-breach-pulse{
  0%,100%{ box-shadow: 0 0 0 0 rgba(255,92,122,0); }
  50%{ box-shadow: 0 0 12px 1px rgba(255,92,122,0.25); }
}
@media (prefers-reduced-motion: reduce){
  .card.esc{ animation:none; box-shadow: 0 0 8px 1px rgba(255,92,122,0.2); }
}
</file>

