      if (historyRisk === "medium") return (l.risk ?? "").toUpperCase() === "UNKNOWN";
      if (historyRisk === "low") return (l.risk ?? "").toUpperCase() === "LOW";
      return true;
    });
  }, [lookups, historyFilter, historyRisk]);

  function runScreen(e?: React.FormEvent) {
    e?.preventDefault();
