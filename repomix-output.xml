"use client";

import { useQuery } from "@tanstack/react-query";
import { getCases } from "../../../../lib/api";
import type { Case, CaseStatus } from "@sih/shared-types";
import React from "react";

// Helper to group cases by status
function groupCases(cases: Case[]) {
  const groups: Record<CaseStatus, Case[]> = {
    open: [],
    investigating: [],
    escalated: [],
    closed: [],
  };
  
  cases.forEach((c) => {
    if (groups[c.status]) {
      groups[c.status].push(c);
    }
  });
  
  return groups;
}

export function DocketView() {
  const { data: cases = [], isLoading, isError } = useQuery({
    queryKey: ["cases"],
    queryFn: getCases,
    refetchInterval: 10000, // Poll every 10s
  });

  const grouped = React.useMemo(() => groupCases(cases), [cases]);

  const numOpen = grouped.open.length + grouped.investigating.length + grouped.escalated.length;
  const numBreaching = cases.filter(c => c.is_sla_breaching).length;

  if (isLoading) {
    return (
      <div className="panel" style={{ marginTop: "16px", marginBottom: "80px" }}>
        <div className="panel-hd">
          <h3>Case docket — Cyber Crime Cell, Ahmedabad</h3>
          <span className="meta">Loading cases...</span>
        </div>
        <div className="panel-bd" style={{ minHeight: "200px" }} />
      </div>
    );
  }

  if (isError) {
    return (
      <div className="panel" style={{ marginTop: "16px", marginBottom: "80px" }}>
        <div className="panel-hd">
          <h3>Case docket — Cyber Crime Cell, Ahmedabad</h3>
          <span className="meta text-red-500">Error loading cases</span>
        </div>
        <div className="panel-bd" style={{ minHeight: "200px" }} />
      </div>
    );
  }

  return (
    <div className="panel" style={{ marginTop: "16px", marginBottom: "80px" }}>
      <div className="panel-hd">
        <h3>Case docket — Cyber Crime Cell, Ahmedabad</h3>
        <span className="meta">{numOpen} open · {numBreaching} breaching SLA</span>
      </div>
      <div className="panel-bd">
        <div className="board">
          <div className="col">
            <h5><span>New lead</span><span>{grouped.open.length}</span></h5>
            {grouped.open.map((c) => (
              <div key={c.id} className={`card ${c.is_sla_breaching ? 'sla' : ''}`}>
                <div className="cno">{c.title.split(',')[0].substring(0, 20) || c.id.split('-')[0].toUpperCase()}</div>
                <div className="ttl" title={c.description || ""}>{c.description ? (c.description.length > 30 ? c.description.substring(0, 30) + "..." : c.description) : "New investigation"}</div>
                <div className="foot">
                  <span>{c.wallets.length} wallet(s)</span>
                  <span className={c.is_sla_breaching ? "br" : ""}>{c.is_sla_breaching ? 'SLA Breached' : `${Math.floor(c.time_in_state_hours || 0)}h in state`}</span>
                </div>
              </div>
            ))}
          </div>
          
          <div className="col">
            <h5><span>Under review</span><span>{grouped.investigating.length}</span></h5>
            {grouped.investigating.map((c) => (
              <div key={c.id} className={`card ${c.is_sla_breaching ? 'sla' : ''}`}>
                <div className="cno">{c.title.split(',')[0].substring(0, 20) || c.id.split('-')[0].toUpperCase()}</div>
                <div className="ttl" title={c.description || ""}>{c.description ? (c.description.length > 30 ? c.description.substring(0, 30) + "..." : c.description) : "Investigation in progress"}</div>
                <div className="foot">
                  <span>{c.wallets.length} wallet(s)</span>
                  <span className={c.is_sla_breaching ? "br" : ""}>{c.is_sla_breaching ? 'SLA Breached' : `${Math.floor(c.time_in_state_hours || 0)}h in state`}</span>
                </div>
              </div>
            ))}
          </div>
          
          <div className="col">
            <h5><span>Escalated</span><span>{grouped.escalated.length}</span></h5>
            {grouped.escalated.map((c) => (
              <div key={c.id} className={`card esc ${c.is_sla_breaching ? 'sla' : ''}`}>
                <div className="cno">{c.title.split(',')[0].substring(0, 20) || c.id.split('-')[0].toUpperCase()}</div>
                <div className="ttl" title={c.description || ""}>{c.description ? (c.description.length > 30 ? c.description.substring(0, 30) + "..." : c.description) : "Escalated to higher tier"}</div>
                <div className="foot">
                  <span>Auto-escalated</span>
                  <span className={c.is_sla_breaching ? "br" : ""}>{c.is_sla_breaching ? 'SLA Breached' : `${Math.floor(c.time_in_state_hours || 0)}h in state`}</span>
                </div>
              </div>
            ))}
          </div>
          
          <div className="col">
            <h5><span>Filed</span><span>{grouped.closed.length}</span></h5>
            {grouped.closed.map((c) => (
              <div key={c.id} className="card">
                <div className="cno">{c.title.split(',')[0].substring(0, 20) || c.id.split('-')[0].toUpperCase()}</div>
                <div className="ttl" title={c.description || ""}>{c.description ? (c.description.length > 30 ? c.description.substring(0, 30) + "..." : c.description) : "Case closed"}</div>
                <div className="foot">
                  <span>Filed</span>
                  <span>Closed</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}
