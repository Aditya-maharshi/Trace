  color: var(--text-dim);
  font-size: 16px;
  line-height: 1.6;
  margin: 0;
}

.trackGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
  border-radius: 12px;
  overflow: hidden;
}

@media (max-width: 720px) {
  .trackGrid {
    grid-template-columns: 1fr;
  }
}

.trackCard {
  background: var(--bg);
  padding: 36px 32px;
  position: relative;
  transition: transform 0.12s ease, background 0.2s ease;
  transform-style: preserve-3d;
  will-change: transform;
}

.trackCard:hover {
  background: #08080e;
}

.tag {
  font-size: 12px;
  color: var(--text-faint);
  display: block;
  margin-bottom: 18px;
}

.trackCard h3 {
  font-size: 20px;
  font-weight: 600;
  margin: 0 0 10px;
}

.trackCard p {
  font-size: 14.5px;
  line-height: 1.6;
  color: var(--text-dim);
  margin: 0;
  max-width: 440px;
}

.traceSpark {
  width: 100%;
  height: 34px;
  margin-top: 24px;
  display: block;
}

/* ---------- Inspector Section ---------- */
.inspectorSection {
  padding: 0 0 140px;
}

.inspector {
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.7);
}

.inspectorBar {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 20px;
  border-bottom: 1px solid var(--line);
  font-family: 'JetBrains Mono', monospace;
  font-size: 12.5px;
  color: var(--text-faint);
}

.traffic {
  display: flex;
  gap: 6px;
  margin-right: 8px;
}

.traffic span {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.inspectorBar #total-value {
  color: var(--text);
  font-weight: 600;
}

.inspectorBody {
  display: grid;
  grid-template-columns: 280px 1fr;
}

@media (max-width: 760px) {
  .inspectorBody {
    grid-template-columns: 1fr;
  }
}

.inspectorTree {
  border-right: 1px solid var(--line);
  padding: 18px 10px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
}

.treeRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 6px;
  color: var(--text-dim);
  cursor: default;
  transition: background 0.15s ease;
}

.treeRow:hover {
  background: rgba(255, 255, 255, 0.03);
}

.treeRowActive {
  background: rgba(247, 147, 26, 0.08);
  color: var(--text);
}

.treeRow .left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.badge {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

.bBtc { background: var(--btc); }
.bEth { background: var(--eth); }
.bAlt { background: var(--text-faint); }
.bGreen { background: var(--green); }

.chg {
  font-size: 11px;
}

.chg.up {
  color: var(--green);
}

.chg.down {
  color: var(--red);
}

.inspectorWaterfall {
  padding: 24px 28px;
}

.wfRow {
  display: grid;
  grid-template-columns: 140px 1fr 140px;
  align-items: center;
  gap: 16px;
  padding: 10px 0;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--text-dim);
}

.wfLabel {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wfTrack {
  position: relative;
  height: 6px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 3px;
  overflow: hidden;
}

.wfBar {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  border-radius: 3px;
  width: 0%;
  transition: width 1s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.wfTime {
  text-align: right;
  color: var(--text-faint);
  font-size: 11.5px;
}

/* ---------- How it Works ---------- */
.how {
  padding: 0 0 140px;
}

.howSteps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

@media (max-width: 820px) {
  .howSteps {
    grid-template-columns: 1fr;
  }
}

.howStep {
  padding: 32px 28px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--bg-raised);
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.howStep:hover {
  border-color: rgba(247, 147, 26, 0.35);
  transform: translateY(-2px);
}

.howStep .num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  color: var(--btc);
  margin-bottom: 20px;
  display: block;
}

.howStep h3 {
  font-size: 18px;
  font-weight: 600;
  margin: 0 0 10px;
}

.howStep p {
  font-size: 14.5px;
  color: var(--text-dim);
  line-height: 1.6;
  margin: 0;
}

/* ---------- CTA Section ---------- */
.ctaSection {
  padding: 40px 0 140px;
}

.ctaBox {
  text-align: center;
  padding: 76px 32px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: radial-gradient(ellipse 60% 100% at 50% 0%, rgba(140, 157, 252, 0.12), transparent), var(--bg-raised);
}

.ctaBox h2 {
  font-size: clamp(26px, 3.6vw, 40px);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 16px;
}

.ctaBox p {
  color: var(--text-dim);
  font-size: 16px;
  margin: 0 0 34px;
}

.ctaPlatforms {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 32px;
}

.platformPill {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--text-dim);
  border: 1px solid var(--line);
  padding: 8px 16px;
  border-radius: 100px;
  background: rgba(255, 255, 255, 0.02);
}

/* ---------- Footer ---------- */
.footer {
  border-top: 1px solid var(--line);
  padding: 44px 0;
}

.footerRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
