/* ============================================================
   Theme carried over unchanged from the deployed dashboard:
   #06060a base, ambient orange/blue glow, grid overlay,
   white/5 glass panels, Space Grotesk + JetBrains Mono.
   ============================================================ */
:root{
  --bg: #06060a;
  --bg-raised: #0d0d15;
  --bg-card: #101019;
  --line: rgba(255,255,255,0.08);
  --line-soft: rgba(255,255,255,0.05);
  --btc: #f7931a;
  --eth: #8c9dfc;
  --green: #2fe3a3;
  --red: #ff5c7a;
  --amber: #f0b429;
  --text: #f2f2f7;
  --text-dim: #9a9aab;
  --text-faint: #5c5c6c;
}
.gov-dashboard-root{
  min-height: 100vh;
  background: var(--bg); color: var(--text);
  font-family:'Space Grotesk', sans-serif;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
.gov-dashboard-root *, .gov-dashboard-root *::before, .gov-dashboard-root *::after{ box-sizing: border-box; }
.gov-dashboard-root a{ color: inherit; text-decoration: none; }
.gov-dashboard-root a:focus-visible, .gov-dashboard-root button:focus-visible, .gov-dashboard-root input:focus-visible, .gov-dashboard-root select:focus-visible{ outline: 2px solid var(--btc); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce){
  .gov-dashboard-root *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }
}
.gov-dashboard-root .mono{ font-family:'JetBrains Mono', monospace; }

/* ---------- ambient background ---------- */
.ambient{ position: fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
.ambient .orb-a{ position:absolute; top:-25%; left:-25%; width:70vw; height:70vw; border-radius:50%; background: rgba(247,147,26,0.10); filter: blur(160px); }
.ambient .orb-b{ position:absolute; bottom:-25%; right:-25%; width:70vw; height:70vw; border-radius:50%; background: rgba(140,157,252,0.10); filter: blur(160px); }
.ambient .grid{
  position:absolute; inset:0; opacity:0.035;
  background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px);
