  vasp: string;
  hopCount: number;
  confidence: ConfidenceLevel;
  risk: RiskLevel;
  structuringFlag?: boolean;
  summary: string;
  paths: PathResult[];
}

export const ETH_ADDRESS_RE = /^0x[a-fA-F0-9]{40}$/;

export function truncateAddress(address: string) {
  return `${address.slice(0, 6)}…${address.slice(-4)}`;
}
