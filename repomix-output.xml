}

.ring {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: 1px solid var(--text-faint);
}

.coinInfo {
  position: absolute;
  top: 100px;
  right: 40px;
  padding: 16px 20px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: rgba(13, 13, 21, 0.75);
  backdrop-filter: blur(10px);
  z-index: 10;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.ciName {
  font-size: 11px;
  color: var(--text-dim);
  margin-bottom: 4px;
}

.ciPrice {
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 2px;
}

.ciChange {
  font-size: 11px;
  font-weight: 600;
}

.ciChange.up {
  color: var(--green);
}

.ciChange.down {
  color: var(--red);
}

.heroContent {
  position: relative;
  z-index: 5;
  max-width: 660px;
}

.eyebrowTag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--btc);
