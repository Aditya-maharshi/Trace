        ring.rotation.x = Math.PI/2; orbitGroup.add(ring);

        var coinGroup = new THREE.Group();
        var faceMat = new THREE.MeshStandardMaterial({ map: makeSymbolTexture(def.glyph, def.color, def.dark), metalness:0.55, roughness:0.3 });
        var edgeMat = new THREE.MeshStandardMaterial({ color:def.edge, metalness:0.7, roughness:0.35 });
